---
// Sticky header of every back-office page: breadcrumb, title (with the
// unsaved-changes dot), actions on the right, and optional in-page section
// links for the long forms. On narrow screens it also opens the explorer.
import AdminIcon from "./AdminIcon.astro";

interface Props {
    title: string;
    crumbs?: { label: string, href?: string }[];
    count?: number;
    sections?: { id: string, label: string }[];
}

const { title, crumbs = [], count, sections = [] } = Astro.props;
---

<header class="adm-head">
    <div class="adm-head-row">
        <button type="button" class="adm-btn-ghost adm-btn-icon adm-explorer-toggle" data-explorer-toggle aria-controls="adm-explorer" aria-expanded="false" aria-label="Ouvrir l'explorateur">
            <AdminIcon name="menu" />
        </button>
        <div class="adm-head-title">
            {crumbs.length > 0 && (
                <nav class="adm-crumbs" aria-label="Fil d'Ariane">
                    {crumbs.map((crumb, i) => (
                        <>
                            {i > 0 && <AdminIcon name="chevronRight" class="w-3 h-3" />}
                            {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
                        </>
                    ))}
                </nav>
            )}
            <h1 class="adm-title">
                <span class="adm-title-text">{title}</span>
                {count !== undefined && <span class="adm-count">{count}</span>}
                <span class="adm-dirty-dot" title="Modifications non enregistrées"><span class="adm-sr-only">Modifications non enregistrées</span></span>
                <slot name="badges" />
            </h1>
        </div>
        <div class="adm-head-actions">
            <slot name="actions" />
        </div>
    </div>
    {sections.length > 0 && (
        <nav class="adm-tabs" aria-label="Sections du formulaire">
            {sections.map(section => (
                <a href={`#${section.id}`} class="adm-tab" data-section-link>
                    {section.label}
                    <span data-badge hidden></span>
                </a>
            ))}
        </nav>
    )}
</header>
