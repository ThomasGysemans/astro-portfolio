---
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import trans, { LOCALES, stripLocale, pathInLocale } from "@i18n";
import { EMAIL } from "@lib/contact";

const lang = Astro.locals.lang;
const path = stripLocale(Astro.url.pathname);
const home = getRelativeLocaleUrl(lang, "/");
const onHome = path === "/";
// The homepage's sections, reached in place from the homepage and through the
// homepage from anywhere else
const section = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const projectsUrl = getRelativeLocaleUrl(lang, "/projects");
const onProjects = path === "/projects" || path.startsWith("/projects/");

// `spy` marks the links whose section is followed by the scrollspy of the homepage
const links = [
    { href: projectsUrl, label: trans.nav.work[lang], current: onProjects },
    { href: section("methode"), label: trans.nav.method[lang], spy: "methode" },
    { href: section("tarifs"), label: trans.nav.pricing[lang], spy: "tarifs" },
    { href: section("faq"), label: trans.nav.faq[lang], spy: "faq" },
];
const menuLinks = [
    { href: section("pourquoi"), label: trans.nav.why[lang], spy: "pourquoi" },
    { href: projectsUrl, label: trans.nav.work[lang], current: onProjects },
    { href: section("apropos"), label: trans.nav.about[lang], spy: "apropos" },
    { href: section("methode"), label: trans.nav.method[lang], spy: "methode" },
    { href: section("comparatif"), label: trans.nav.compare[lang], spy: "comparatif" },
    { href: section("tarifs"), label: trans.nav.pricing[lang], spy: "tarifs" },
    { href: section("faq"), label: trans.nav.faq[lang], spy: "faq" },
    { href: getRelativeLocaleUrl(lang, "/showcase"), label: trans.nav.showcase[lang] },
];

// The same page in every locale. The abbreviations get a full accessible name,
// in their own language.
const LOCALE_NAMES: Record<App.LangCode, string> = { fr: "français", en: "English" };
const locales = LOCALES.map(locale => ({
    locale,
    name: LOCALE_NAMES[locale],
    href: pathInLocale(locale, Astro.url.pathname),
    current: locale === lang,
}));
---

<header class="nav-wrap">
    <nav class="nav" aria-label={trans.nav.mainnav[lang]}>
        <a class="brand" href={home}>
            <img class="brand-logo" src="/logo-96.png" width="36" height="36" alt="" />
            <span class="brand-name title-4">Thomas Gysemans</span>
            <span class="sr-only">, {trans.nav.home[lang]}</span>
        </a>
        <ul class="nav-links">
            {links.map(link => (
                <li>
                    <a class="nav-link title-4" href={link.href} data-spy={link.spy} aria-current={link.current ? "page" : undefined}>{link.label}</a>
                </li>
            ))}
        </ul>
        <div class="lang" role="group" aria-label={trans.nav.language[lang]}>
            {locales.map(item => item.current ? (
                <span class="lang-opt caption-3" lang={item.locale} aria-current="true">{item.locale.toUpperCase()}<span class="sr-only">, {item.name}</span></span>
            ) : (
                <a class="lang-opt caption-3" href={item.href} lang={item.locale} hreflang={item.locale} data-set-lang={item.locale}>{item.locale.toUpperCase()}<span class="sr-only">, {item.name}</span></a>
            ))}
        </div>
        <a class="btn btn-primary btn-sm button-sm nav-cta" href={section("devis")}>{trans.nav.quote[lang]}</a>
        <button class="icon-btn menu-btn" type="button" id="menu-btn" aria-expanded="false" aria-controls="menu" aria-label={trans.common.openmenu[lang]} data-open-label={trans.common.openmenu[lang]} data-close-label={trans.common.closemenu[lang]}>
            <span class="bars" aria-hidden="true"><i></i><i></i></span>
        </button>
    </nav>
</header>

<div class="menu" id="menu" hidden>
    <nav aria-label={trans.nav.mobilenav[lang]}>
        <ul>
            {menuLinks.map((link, i) => (
                <li class="stagger" style={`--i:${i}`}>
                    <a class="menu-link heading-5" href={link.href} data-spy={link.spy} aria-current={link.current ? "page" : undefined}>{link.label}</a>
                </li>
            ))}
        </ul>
        <div class="menu-foot stagger" style={`--i:${menuLinks.length}`}>
            <a class="btn btn-primary button-lg" href={section("devis")}>{trans.nav.quotelong[lang]} <Icon name="arrow-right" class="size-5" /></a>
            <p class="caption-2 text-muted">{trans.nav.menufoot[lang]} · {EMAIL}</p>
        </div>
    </nav>
</div>

<style>
    .nav-wrap {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        display: flex;
        justify-content: center;
        pointer-events: none;
        padding-top: calc(16px + env(safe-area-inset-top, 0px));
        padding-left: max(16px, env(safe-area-inset-left, 0px));
        padding-right: max(16px, env(safe-area-inset-right, 0px));
    }

    .nav {
        pointer-events: auto;
        display: flex;
        align-items: center;
        gap: 4px;
        max-width: 100%;
        padding: 4px;
        border-radius: 9999px;
        border: 1px solid var(--line-strong);
        background: var(--nav-bg);
        -webkit-backdrop-filter: blur(16px) saturate(1.4);
        backdrop-filter: blur(16px) saturate(1.4);
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding-right: 12px;
        border-radius: 9999px;
        color: var(--heading);
    }

    .brand-logo {
        width: 36px;
        height: 36px;
        padding: 2px;
        flex-shrink: 0;
        transition: transform 700ms var(--ease-space);
    }

    .brand:hover .brand-logo {
        transform: rotate(-24deg);
    }

    .brand-name {
        white-space: nowrap;
    }

    /* On small screens the name is only hidden visually, so the link keeps its accessible name */
    @media (max-width: 479px) {
        .brand .brand-name {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
        }

        .brand {
            padding-right: 0;
        }
    }

    /* Language switch: always visible in the bar, the current language as a filled pill */
    .lang {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        padding: 2px;
        margin-left: auto;
        border-radius: 9999px;
        border: 1px solid var(--line-strong);
        background: var(--fill);
    }

    .lang-opt {
        display: inline-grid;
        place-items: center;
        min-width: 36px;
        height: 28px;
        padding: 0 8px;
        border-radius: 9999px;
        color: var(--text);
        font-family: var(--font-mono);
        letter-spacing: 0.04em;
        transition: background-color 300ms var(--ease-space), color 300ms var(--ease-space);
    }

    a.lang-opt:hover {
        color: var(--heading);
        background: var(--fill-hover);
    }

    .lang-opt[aria-current] {
        background: var(--heading);
        color: var(--bg);
    }

    .nav-links {
        display: none;
        align-items: center;
        gap: 2px;
    }

    .nav-link {
        display: inline-flex;
        padding: 8px 12px;
        border-radius: 9999px;
        color: var(--text);
        transition: background-color 300ms var(--ease-space), color 300ms var(--ease-space);
    }

    .nav-link:hover {
        color: var(--heading);
        background: var(--fill-hover);
    }

    .nav-link[aria-current] {
        color: var(--heading);
        background: var(--fill-active);
    }

    .nav-cta {
        margin-left: 4px;
    }

    .menu-btn .bars {
        position: relative;
        width: 18px;
        height: 12px;
        display: block;
    }

    .menu-btn .bars i {
        position: absolute;
        left: 0;
        width: 18px;
        height: 2px;
        border-radius: 9999px;
        background: currentColor;
        transition: transform 500ms var(--ease-space);
    }

    .menu-btn .bars i:first-child { top: 1px; }
    .menu-btn .bars i:last-child { top: 9px; }
    .menu-btn[aria-expanded="true"] .bars i:first-child { transform: translateY(4px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] .bars i:last-child { transform: translateY(-4px) rotate(-45deg); }

    @media (min-width: 960px) {
        .nav-links { display: flex; }
        .menu-btn { display: none; }
        .lang { margin-left: 8px; }
    }

    .menu {
        position: fixed;
        inset: 0;
        z-index: 40;
        background: var(--menu-bg);
        -webkit-backdrop-filter: blur(24px);
        backdrop-filter: blur(24px);
        padding-top: calc(112px + env(safe-area-inset-top, 0px));
        padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px));
        padding-left: max(24px, env(safe-area-inset-left, 0px));
        padding-right: max(24px, env(safe-area-inset-right, 0px));
        overflow-y: auto;
        opacity: 0;
        transition: opacity 300ms var(--ease-space);
    }

    .menu:global(.open) {
        opacity: 1;
    }

    .menu nav {
        display: flex;
        flex-direction: column;
        gap: 32px;
        max-width: 560px;
        margin-inline: auto;
    }

    .menu ul {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .menu-link {
        display: flex;
        padding: 8px 0;
        border-radius: 8px;
    }

    .menu-link[aria-current] {
        color: var(--accent-text);
    }

    .stagger {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 500ms var(--ease-space), transform 500ms var(--ease-space);
        transition-delay: calc(var(--i, 0) * 50ms);
    }

    .menu:global(.open) .stagger {
        opacity: 1;
        transform: none;
    }

    .menu-foot {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    :global(:root[data-motion="reduce"]) .brand:hover .brand-logo,
    :global(:root[data-motion="reduce"]) .stagger {
        transform: none;
    }
</style>

<script>
    // Mobile menu: a full-screen sheet. While it is open, the rest of the page
    // is inert (focus stays in the menu) and does not scroll; Escape closes it.
    const menu = document.getElementById("menu");
    const button = document.getElementById("menu-btn");
    const outside = [document.querySelector("main"), document.querySelector("footer")];

    function openMenu(): void {
        if (!menu || !button) return;
        menu.hidden = false;
        // Two frames: the sheet must be displayed before it can fade in
        requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add("open")));
        button.setAttribute("aria-expanded", "true");
        button.setAttribute("aria-label", button.dataset.closeLabel ?? "");
        document.documentElement.classList.add("lock");
        outside.forEach(el => { if (el) el.inert = true; });
        menu.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
    }

    function closeMenu(returnFocus: boolean): void {
        if (!menu || !button) return;
        menu.classList.remove("open");
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", button.dataset.openLabel ?? "");
        document.documentElement.classList.remove("lock");
        outside.forEach(el => { if (el) el.inert = false; });
        setTimeout(() => { if (!menu.classList.contains("open")) menu.hidden = true; }, 300);
        if (returnFocus) button.focus();
    }

    const isOpen = () => button?.getAttribute("aria-expanded") === "true";

    button?.addEventListener("click", () => (isOpen() ? closeMenu(true) : openMenu()));
    menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => closeMenu(false)));
    document.addEventListener("keydown", event => {
        if (event.key === "Escape" && isOpen()) closeMenu(true);
    });
    matchMedia("(min-width: 960px)").addEventListener("change", event => {
        if (event.matches && isOpen()) closeMenu(false);
    });

    // An explicit language choice is recorded before navigating: the cookie
    // becomes authoritative, so the middleware never redirects the visitor away
    // from the language they just picked.
    document.querySelectorAll<HTMLAnchorElement>("[data-set-lang]").forEach(link => {
        link.addEventListener("click", () => {
            document.cookie = `lang=${link.dataset.setLang};path=/;max-age=31536000;samesite=lax`;
        });
    });

    // Scrollspy of the homepage: the link of the section in the middle of the
    // screen is marked as the current location.
    const spied = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-spy]"));
    const sections = [...new Set(spied.map(link => link.dataset.spy))]
        .map(id => document.getElementById(id ?? ""))
        .filter((el): el is HTMLElement => !!el);
    if (sections.length > 0 && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
            for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                for (const link of spied) {
                    if (link.dataset.spy === entry.target.id) link.setAttribute("aria-current", "location");
                    else link.removeAttribute("aria-current");
                }
            }
        }, { rootMargin: "-45% 0px -50% 0px" });
        // The hero has no link: reaching it clears the mark
        const top = document.getElementById("top");
        if (top) observer.observe(top);
        sections.forEach(section => observer.observe(section));
    }
</script>
