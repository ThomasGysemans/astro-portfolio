---
import "flag-icons/css/flag-icons.min.css";
import AdminLayout from "@layouts/AdminLayout.astro";
import AdminIcon from "@components/admin/AdminIcon.astro";
import EditorHeader from "@components/admin/EditorHeader.astro";

export type AdminReviewRow = {
    id: string,
    quote: string,
    role: string,
    company: string,
    year: number,
    rating: number,
    translated: boolean,
};

interface Props {
    reviews: AdminReviewRow[];
    notice?: string;
    error?: string;
}

const { reviews, notice, error } = Astro.props;
---

<AdminLayout title="Avis" {notice} {error}>
    <EditorHeader title="Avis clients" count={reviews.length}>
        <a slot="actions" href="/admin/reviews/new" class="adm-btn"><AdminIcon name="plus" />Nouvel avis</a>
    </EditorHeader>

    {reviews.length > 0 ? (
        <table class="adm-table">
            <thead>
                <tr>
                    <th scope="col">Client</th>
                    <th scope="col">Année</th>
                    <th scope="col">Note</th>
                    <th scope="col">Avis</th>
                    <th scope="col">Anglais</th>
                    <th scope="col"><span class="adm-sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {reviews.map(review => (
                    <tr>
                        <td class="adm-cell-wide">
                            <a href={`/admin/reviews/${review.id}`} class="adm-row-title">{review.company}</a>
                            {review.role}
                        </td>
                        <td class="adm-cell-wide"><span class="adm-mono">{review.year}</span></td>
                        <td class="adm-cell-wide">
                            <span class="adm-stars" title={`${review.rating}/5`}>
                                <span class="adm-sr-only">Note : {review.rating} sur 5</span>
                                <span aria-hidden="true">{"★".repeat(review.rating)}</span><span class="adm-stars-off" aria-hidden="true">{"★".repeat(5 - review.rating)}</span>
                            </span>
                        </td>
                        <td class="adm-cell-wide"><p class="adm-quote">« {review.quote} »</p></td>
                        <td class="adm-cell-wide">
                            {review.translated
                                ? <span class="adm-badge"><span class="fi fi-gb rounded-[2px]" aria-hidden="true"></span>Traduit</span>
                                : <span class="adm-badge adm-badge-hidden">Repli français</span>}
                        </td>
                        <td class="adm-cell-actions">
                            <div>
                                <form method="POST" data-async data-confirm={`Supprimer l'avis de ${review.company} ? Il disparaîtra de la page /freelance. Cette action est irréversible.`}>
                                    <input type="hidden" name="action" value="delete">
                                    <input type="hidden" name="id" value={review.id}>
                                    <button type="submit" class="adm-btn-danger adm-btn-sm adm-btn-icon" title="Supprimer" aria-label={`Supprimer l'avis de ${review.company}`}><AdminIcon name="trash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    ) : (
        <div class="adm-empty">
            <strong>Aucun avis pour le moment.</strong>
            Ajoute le premier avec « Nouvel avis » : il s'affichera sur la page /freelance.
        </div>
    )}
</AdminLayout>

