---
import "flag-icons/css/flag-icons.min.css";
import AdminLayout from "@layouts/AdminLayout.astro";
import AdminIcon from "@components/admin/AdminIcon.astro";
import EditorHeader from "@components/admin/EditorHeader.astro";
import type { FieldErrors } from "@data/admin/forms";

export type ReviewFormValues = {
    quote: string,
    role: string,
    company: string,
    year: string,
    rating: string,
    quoteEn: string,
    roleEn: string,
    companyEn: string,
};

interface Props {
    id?: string;
    values: ReviewFormValues;
    error?: string;
    fields?: FieldErrors;
}

const { id, values, error, fields } = Astro.props;
const isNew = !id;
const heading = isNew ? "Nouvel avis" : values.company || "Avis";
const title = isNew ? "Nouvel avis" : `Avis : ${values.company}`;

const texts = [
    { name: "quote", label: "Citation", fr: values.quote, en: values.quoteEn, required: true, area: 5 },
    { name: "role", label: "Rôle", hint: "Gérant, Fondateur…", fr: values.role, en: values.roleEn },
    { name: "company", label: "Entreprise", fr: values.company, en: values.companyEn, required: true },
];
---

<AdminLayout {title} {error} {fields}>
    <EditorHeader title={heading} crumbs={[{ label: "Avis clients", href: "/admin/reviews" }]}>
        <button slot="actions" type="submit" form="review-form" class="adm-btn"><AdminIcon name="save" />{isNew ? "Créer l'avis" : "Enregistrer"}</button>
    </EditorHeader>

    <form id="review-form" method="POST" autocomplete="off" class="adm-doc" data-async data-primary>
        <section class="adm-section">
            <div class="adm-section-intro">
                <h2>Avis</h2>
                <p>Affiché sur /freelance. C'est ta reformulation des retours du client : reste fidèle à ce qu'il a dit.</p>
                <p>Sans guillemets : ils sont ajoutés à l'affichage. L'anglais est facultatif et retombe sur le français.</p>
            </div>
            <div class="adm-section-body">
                <div class="adm-parallel">
                    <div class="adm-parallel-head"><span class="fi fi-fr" aria-hidden="true"></span>Français</div>
                    <div class="adm-parallel-head"><span class="fi fi-gb" aria-hidden="true"></span>Anglais <em>vide = texte français</em></div>
                    {texts.map(row => (
                        <>
                            <div class="adm-field">
                                <label for={row.name} class="adm-label">
                                    <span class="fi fi-fr rounded-[2px]" aria-hidden="true"></span>{row.label}
                                    {row.hint && <span class="adm-label-hint">{row.hint}</span>}
                                </label>
                                {row.area
                                    ? <textarea id={row.name} name={row.name} class="adm-input" rows={row.area} required={row.required}>{row.fr}</textarea>
                                    : <input id={row.name} name={row.name} class="adm-input" value={row.fr} required={row.required}>}
                            </div>
                            <div class="adm-field">
                                <label for={`${row.name}_en`} class="adm-label">
                                    <span class="fi fi-gb rounded-[2px]" aria-hidden="true"></span>{row.label}
                                    <span class="adm-sr-only">(anglais)</span>
                                </label>
                                {row.area
                                    ? <textarea id={`${row.name}_en`} name={`${row.name}_en`} class="adm-input" rows={row.area} lang="en">{row.en}</textarea>
                                    : <input id={`${row.name}_en`} name={`${row.name}_en`} class="adm-input" value={row.en} lang="en">}
                            </div>
                        </>
                    ))}
                </div>
            </div>
        </section>

        <section class="adm-section">
            <div class="adm-section-intro">
                <h2>Détails</h2>
                <p>Les avis sont triés du plus récent au plus ancien.</p>
            </div>
            <div class="adm-section-body">
                <div class="adm-grid">
                    <div class="adm-field">
                        <label for="year" class="adm-label">Année</label>
                        <input id="year" name="year" type="number" class="adm-input adm-input-mono" value={values.year} required>
                    </div>
                    <div class="adm-field" data-field="rating" data-label="Note">
                        <span class="adm-label" id="rating-label">Note</span>
                        <div class="adm-rating" role="radiogroup" aria-labelledby="rating-label">
                            {[1, 2, 3, 4, 5].map(n => (
                                <label title={`${n}/5`}>
                                    <input type="radio" name="rating" value={String(n)} checked={values.rating === String(n)} required aria-label={`${n} sur 5`}>
                                    <span aria-hidden="true">★</span>
                                </label>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="adm-form-foot">
            <button type="submit" class="adm-btn"><AdminIcon name="save" />{isNew ? "Créer l'avis" : "Enregistrer"}</button>
            <span class="adm-help"><span class="adm-mono">⌘S</span> / <span class="adm-mono">Ctrl+S</span> enregistre depuis n'importe quel champ.</span>
        </div>
    </form>
</AdminLayout>
