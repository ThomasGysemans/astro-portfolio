---
// Deliberately anonymous: nothing on this page says what it protects.
// Posted natively (no async runtime): there is nothing to lose on a failed
// login, and the email is sent back into its field.
import AdminLayout from "@layouts/AdminLayout.astro";

interface Props {
    error?: string;
    email?: string;
}

const { error, email } = Astro.props;
---

<AdminLayout title="Connexion" nav={false} {error}>
    <div class="adm-login-panel">
        <header>
            <h1>Connexion</h1>
        </header>
        <form method="POST">
            {error && <p class="adm-banner-error" role="alert">{error}</p>}
            <div class="adm-field">
                <label for="email" class="adm-label">Email</label>
                <input id="email" name="email" type="email" class="adm-input" value={email ?? ""} required autofocus={!email} autocomplete="username">
            </div>
            <div class="adm-field">
                <label for="password" class="adm-label">Mot de passe</label>
                <input id="password" name="password" type="password" class="adm-input" required autofocus={!!email} autocomplete="current-password">
            </div>
            <button type="submit" class="adm-btn">Se connecter</button>
        </form>
    </div>
</AdminLayout>
