---
import { getAllProjects, homepageWork } from "@data/projects";
import { getReviews } from "@data/reviews";
import { ifAvailable } from "@data/pb";
import MainLayout from "@layouts/MainLayout.astro";
import Hero from "@components/home/Hero.astro";
import WhyMe from "@components/home/WhyMe.astro";
import Tagline from "@components/home/Tagline.astro";
import Work from "@components/home/Work.astro";
import About from "@components/home/About.astro";
import Method from "@components/home/Method.astro";
import Compare from "@components/home/Compare.astro";
import Pricing from "@components/home/Pricing.astro";
import Faq from "@components/home/Faq.astro";
import Launch from "@components/home/Launch.astro";
import type { PlanetPlacement } from "@lib/space/planets";
import trans, { faq } from "@i18n";

const lang = Astro.locals.lang;
// One cached PocketBase query feeds every project of the page. The homepage
// stands on its own without them: if PocketBase is unreachable, the sections
// that show projects and reviews are simply left out.
const [projects = [], reviews = []] = await Promise.all([ifAvailable(getAllProjects()), ifAvailable(getReviews())]);
// The Work section: the wide card, then the cards checked "Sur l'accueil";
// left out when the back-office flags none of them
const { headline, others } = homepageWork(projects);
// A review links to its project only while that project is public
const reviewed = reviews.map(review => ({ review, project: projects.find(p => p.slug === review.project) }));

// A trip home through the solar system as the page scrolls: Neptune at the top,
// then Uranus, Saturn, Jupiter and Mars, down to the Earth and its Moon next to
// the launch pad. Mercury and Venus are not on the way.
const planets: PlanetPlacement[] = [
    // On phones each one sits in a gap between two blocks of text, near an
    // edge of the screen (measured at 360 to 430px wide, with the reduced
    // phone parallax of planets.ts)
    { name: "neptune", anchor: "#top", at: 0.66, x: 0.86, mAt: 0.9, mx: 0.03 },
    { name: "uranus", anchor: "#tagline", at: 0.5, x: 0.11, mAt: 0.025, mx: 0.94 },
    // Saturn fills the right of "Behind the screen", which only has one column
    // of copy from 1024px; on tablets and phones it sits beside the portrait
    { name: "saturn", anchor: "#apropos", at: 0.45, x: 0.78, tAt: 0.12, tx: 0.84, mAt: 0.13, mx: 0.8 },
    { name: "jupiter", anchor: "#comparatif", at: 0.3, x: -0.045, mAt: -0.005, mx: 1 },
    { name: "mars", anchor: "#tarifs", at: 0.08, x: 0.9, mAt: 0.02, mx: 0.92 },
    // The Earth stays clear of the quote form: beside it from 1024px, near the
    // edge so it fits as soon as the form leaves a margin; beside the heading on
    // tablets, where the form takes the whole width
    { name: "earth", anchor: "#devis", at: 0.34, x: 0.05, tAt: 0.04, tx: 0.04, mAt: -0.01, mx: 0.12 },
];

// The visible questions, also published as structured data so both always match
const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(item => ({
        "@type": "Question",
        name: item.q[lang],
        acceptedAnswer: { "@type": "Answer", text: item.a[lang] },
    })),
};
---

<MainLayout title={trans.home.title[lang]} description={trans.home.description[lang]} {planets}>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqData).replace(/</g, "\\u003c")} is:inline />
    <main id="main-content" tabindex="-1">
        <Hero />
        <WhyMe />
        <Tagline />
        {(headline || others.length > 0) && <Work feature={headline} {others} reviews={reviewed} total={projects.length} />}
        <About {projects} {reviews} />
        <Method />
        <Compare />
        <Pricing />
        <Faq />
        <Launch />
    </main>
</MainLayout>
