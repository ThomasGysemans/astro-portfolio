---
import { getAllProjects } from "@data/projects";
import { getReviews } from "@data/reviews";
import { ifAvailable } from "@data/pb";
import MainLayout from "@layouts/MainLayout.astro";
import Hero from "@components/home/Hero.astro";
import WhyMe from "@components/home/WhyMe.astro";
import Tagline from "@components/home/Tagline.astro";
import Work from "@components/home/Work.astro";
import About from "@components/home/About.astro";
import Method from "@components/home/Method.astro";
import Compare from "@components/home/Compare.astro";
import Pricing from "@components/home/Pricing.astro";
import Faq from "@components/home/Faq.astro";
import Launch from "@components/home/Launch.astro";
import type { PlanetPlacement } from "@lib/space/planets";
import trans, { faq } from "@i18n";

const lang = Astro.locals.lang;
// One cached PocketBase query feeds every project of the page. The homepage
// stands on its own without them: if PocketBase is unreachable, the sections
// that show projects and reviews are simply left out.
const [projects = [], reviews = []] = await Promise.all([ifAvailable(getAllProjects()), ifAvailable(getReviews())]);
const featured = projects.filter(p => p.featured);
// The wide card is the project flagged in the back-office ("carousel"), the two
// cards under it the next featured ones
const headline = projects.find(p => p.carousel) ?? featured[0];
const others = featured.filter(p => p !== headline).slice(0, 2);
// Next to "Behind the screen": the featured astronomy game
const astronomy = featured.find(p => p.categories.includes("games") && p !== headline && !others.includes(p));

// A trip home through the solar system as the page scrolls: Neptune at the top,
// then Uranus, Saturn, Jupiter and Mars, down to the Earth and its Moon next to
// the launch pad. Mercury and Venus are not on the way.
const planets: PlanetPlacement[] = [
    { name: "neptune", anchor: "#top", at: 0.66, x: 0.86, mAt: 1.38, mx: 0.12 },
    { name: "uranus", anchor: "#tagline", at: 0.5, x: 0.11, mAt: 0.05, mx: 0.1 },
    { name: "saturn", anchor: "#apropos", at: 0, x: 0.88, mAt: 0.02, mx: 0.86 },
    { name: "jupiter", anchor: "#comparatif", at: 0.3, x: -0.045, mAt: 0.02, mx: 0.04 },
    { name: "mars", anchor: "#tarifs", at: 0.08, x: 0.9, mAt: 0.02, mx: 0.88 },
    { name: "earth", anchor: "#devis", at: 0.34, x: 0.13, mAt: -0.01, mx: 0.8 },
];

// The visible questions, also published as structured data so both always match
const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(item => ({
        "@type": "Question",
        name: item.q[lang],
        acceptedAnswer: { "@type": "Answer", text: item.a[lang] },
    })),
};
---

<MainLayout title={trans.home.title[lang]} description={trans.home.description[lang]} {planets}>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqData).replace(/</g, "\\u003c")} is:inline />
    <main id="main-content" tabindex="-1">
        <Hero />
        <WhyMe />
        <Tagline />
        {headline && <Work feature={headline} {others} {reviews} total={projects.length} />}
        <About project={astronomy} total={projects.length} />
        <Method />
        <Compare />
        <Pricing />
        <Faq />
        <Launch />
    </main>
</MainLayout>
