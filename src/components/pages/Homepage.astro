---
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAllProjects, getCarouselProject, getFeaturedProjects } from "@data/projects";
import { getTechnologies } from "@data/technologies";
import FeaturedCarousel from "@components/svelte/FeaturedCarousel.svelte";
import AvailabilityBadge from "@components/AvailabilityBadge.astro";
import ProjectCard from "@components/ProjectCard.astro";
import StatCard from "@components/StatCard.astro";
import MainLayout from "@layouts/MainLayout.astro";
import Earth from "@components/svelte/Earth.svelte";
import { isVideo } from "@data/media";
import trans from "@i18n";

const lang = Astro.locals.lang;
// The technologies come from the same 60s cache as /projects; the stat
// numbers are computed from data already needed by the page, so keeping
// them in sync with the database costs no extra latency.
const [featured, allProjects, carouselProject, technologies] = await Promise.all([getFeaturedProjects(), getAllProjects(), getCarouselProject(), getTechnologies()]);
const totalProjects = allProjects.length;
const allProjectsLabel = trans.home.allprojectscount[lang].replace("{count}", `${totalProjects}`);
const projectsUrl = getRelativeLocaleUrl(lang, "/projects");
const showcaseUrl = getRelativeLocaleUrl(lang, "/showcase");
const freelanceUrl = getRelativeLocaleUrl(lang, "/freelance");

// The carousel explores the pictures of a single project (picked in the back-office).
const carouselMedia = (carouselProject?.pictures ?? []).map(({ url }) => ({ src: url, video: isVideo(url) }));
const carouselInfo = carouselProject && {
    name: carouselProject.name[lang],
    tagline: carouselProject.tagline[lang],
    caption: carouselProject.caption[lang],
    href: getRelativeLocaleUrl(lang, `/projects/${carouselProject.slug}`),
};

const carouselLabels = {
    details: trans.common.details[lang],
    prevPicture: trans.carousel.previouspicture[lang],
    nextPicture: trans.carousel.nextpicture[lang],
    gotoPicture: trans.carousel.gotopicture[lang],
    pause: trans.carousel.pause[lang],
    resume: trans.carousel.resume[lang],
};

const roleChips = [
    { label: trans.home.webdev[lang], icon: "globe" },
    { label: trans.home.appdev[lang], icon: "smartphone" },
    { label: trans.home.designer[lang], icon: "flower-2" },
];

const aboutCards = [
    { title: trans.home.studiestitle[lang], text: trans.home.studies[lang] },
    { title: trans.home.experiencetitle[lang], text: trans.home.experience[lang] },
    { title: trans.home.freelancetitle[lang], text: trans.home.freelance[lang] },
    { title: trans.home.teamskillstitle[lang], text: trans.home.teamskills[lang] },
];
---

<MainLayout title={trans.common.title[lang]}>
    <main id="main-content" class="relative overflow-hidden">
        <!-- Nebula-like scene, faded out in light mode through --hero-scene. -->
        <div class="hero-scene absolute inset-0 pointer-events-none" aria-hidden="true" />

        <div class="relative max-w-415 mx-auto">
            <!-- hero -->
            <section class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-5 px-page pt-[clamp(32px,7vh,110px)] pb-8 items-center min-h-[min(660px,calc(100vh-320px))]">
                <div>
                    <div class="mb-5.5">
                        <AvailabilityBadge />
                    </div>
                    <h1 class="text-[clamp(34px,3.4vw,60px)] font-bold leading-[1.16] mb-4 text-heading glow" set:html={trans.home.herotitle[lang]} />
                    <p class="text-[clamp(14.5px,1vw,16.5px)] leading-[1.7] text-body max-w-120 mb-6" set:html={trans.home.herointro[lang]} />
                    <div class="flex items-center gap-3 mb-6.5 flex-wrap">
                        <a href={freelanceUrl} class="cta-pulse text-sm font-extrabold py-3.75 px-7.5 rounded-[10px] whitespace-nowrap">{trans.home.createproject[lang]}</a>
                        <a href={showcaseUrl} class="btn-outline text-[13px] py-3 px-5.5">{trans.home.showcasemode[lang]}</a>
                        <div class="flex gap-2 ml-1.5">
                            <a href="https://github.com/ThomasGysemans" target="_blank" rel="noopener" aria-label={`${trans.common.mygithubaccount[lang]} (${trans.common.newwindow[lang]})`} class="social-circle"><Icon name="github" class="text-lg text-heading" /></a>
                            <a href="https://fr.linkedin.com/in/thomas-gysemans-950536268" target="_blank" rel="noopener" aria-label={`${trans.common.mylinkedinaccount[lang]} (${trans.common.newwindow[lang]})`} class="social-circle"><Icon name="linkedin" class="text-lg text-heading" /></a>
                            <a href="https://malt.fr/profile/thomasgysemans" target="_blank" rel="noopener" aria-label={`${trans.common.mymaltprofile[lang]} (${trans.common.newwindow[lang]})`} class="social-circle"><Icon name="malt" class="text-lg text-malt" /></a>
                        </div>
                    </div>
                    <div class="flex gap-2.5 flex-wrap">
                        {roleChips.map(chip => (
                            <span class="token-chip text-[12.5px] py-2 px-4">
                                <Icon name={chip.icon} class="text-sm text-accent-strong" />
                                {chip.label}
                            </span>
                        ))}
                    </div>
                </div>
                <div class="relative flex justify-center">
                    <div class="relative w-[clamp(260px,32vw,540px)] max-w-full aspect-square">
                        <div class="absolute inset-0 rounded-full bg-[radial-gradient(circle,rgba(97,156,243,.28),transparent_70%)]" aria-hidden="true" />
                        <Earth dragLabel={trans.home.dragtoorbit[lang]} client:idle />
                    </div>
                </div>
            </section>

            <!-- stats -->
            <section class="grid grid-cols-[repeat(auto-fit,minmax(210px,1fr))] gap-4 px-page pt-2.5 pb-8.5">
                <StatCard value={trans.home.stat1num[lang]}>{trans.home.stat1[lang]}</StatCard>
                <StatCard value={`${totalProjects}`}>{trans.home.stat2[lang]}</StatCard>
                <StatCard value={`${technologies.length}`}>{trans.home.stat3[lang]}</StatCard>
                <StatCard value={trans.home.stat4num[lang]}>{trans.home.stat4[lang]}</StatCard>
            </section>

            <!-- featured carousel: the pictures of the project picked in the back-office -->
            {carouselInfo && carouselMedia.length > 0 && (
                <section class="px-page pt-1.5 pb-10">
                    <div class="flex justify-between items-baseline mb-4 gap-4 flex-wrap">
                        <h2 class="text-[23px] font-bold m-0 text-heading">{trans.home.featuredprojects[lang]}</h2>
                        <a href={showcaseUrl} class="text-[13px] font-bold text-accent hover:underline hover:brightness-110">{trans.home.opentheshowcase[lang]}</a>
                    </div>
                    <FeaturedCarousel project={carouselInfo} media={carouselMedia} labels={carouselLabels} client:visible />
                </section>
            )}

            <!-- selected projects -->
            <section class="px-page pb-10">
                <div class="flex justify-between items-baseline mb-5 gap-4 flex-wrap">
                    <h2 class="text-[23px] font-bold m-0 text-heading">{trans.home.selectedprojects[lang]}</h2>
                    <a href={projectsUrl} class="text-[13px] font-bold text-accent hover:underline hover:brightness-110">{allProjectsLabel}</a>
                </div>
                <div class="grid grid-cols-[repeat(auto-fit,minmax(min(380px,100%),1fr))] gap-5">
                    {featured.map(project => (
                        <ProjectCard {project} />
                    ))}
                </div>
                <div class="flex justify-center mt-6">
                    <a href={projectsUrl} class="btn-outline text-[13px] py-3 px-6.5">{trans.common.seemore[lang]}</a>
                </div>
            </section>

            <!-- about -->
            <section class="px-page pt-1 pb-11">
                <h2 class="text-[23px] font-bold mb-5 text-heading">{trans.home.aboutme[lang]}</h2>
                <div class="grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-4">
                    {aboutCards.map(card => (
                        <div class="surface-card p-5">
                            <h3 class="text-[13px] font-bold text-accent-heading mb-2">{card.title}</h3>
                            <p class="text-[11.5px] leading-[1.7] text-body" set:html={card.text} />
                        </div>
                    ))}
                </div>
            </section>
        </div>
    </main>
</MainLayout>

<style>
    @reference "../../styles/tailwind.css";

    .hero-scene {
        opacity: var(--hero-scene);
        transition: opacity .3s;
        background:
            radial-gradient(ellipse 60% 50% at 70% 30%, rgba(97, 156, 243, .17), transparent 65%),
            radial-gradient(ellipse 40% 35% at 20% 65%, rgba(97, 156, 243, .07), transparent 70%),
            linear-gradient(180deg, rgba(3, 15, 32, .25), #030F20 78%);
    }

    @keyframes cta-pulse {
        0% { box-shadow: 0 0 0 0 rgba(97, 156, 243, .55); }
        100% { box-shadow: 0 0 0 14px rgba(97, 156, 243, 0); }
    }

    .cta-pulse {
        background: linear-gradient(135deg, #87b3f6, #a9c8f9);
        color: #02101f;
        animation: cta-pulse 2.2s ease-out infinite;
        transition: transform .25s, filter .25s;

        &:hover {
            transform: translateY(-3px) scale(1.05);
            filter: brightness(1.08);
        }
    }

    .social-circle {
        @apply w-10 h-10 rounded-full border border-edge-strong bg-chip inline-flex items-center justify-center;
        transition: transform .2s, border-color .2s;

        &:hover {
            @apply border-accent;
            transform: translateY(-3px);
        }
    }
</style>
