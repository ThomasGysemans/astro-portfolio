---
import { getRelativeLocaleUrl } from "astro:i18n";
import MainLayout from "@layouts/MainLayout.astro";
import trans from "@i18n";

const lang = Astro.locals.lang;

// Rendered both by the router (unmatched routes) and by explicit
// `Astro.rewrite("/404")` calls, which don't set the status on their own.
// Forcing 404 here avoids a soft 404 (a 200 response for a missing page).
Astro.response.status = 404;
---

<MainLayout title={trans.common.title[lang]} footerCta={false} noindex>
    <main id="main-content" class="flex-1 flex flex-col gap-6 justify-center items-center py-16 px-page">
        <img src="/logos/black-hole.svg" alt={trans.common.blackhole[lang]} class="w-60" />
        <h1 class="text-center text-2xl text-heading font-bold">{trans.error.notfound[lang]} (404)</h1>
        <a href={getRelativeLocaleUrl(lang, "/")} class="btn-outline text-sm py-3 px-6.5">{trans.error.backhome[lang]}</a>
    </main>
</MainLayout>
