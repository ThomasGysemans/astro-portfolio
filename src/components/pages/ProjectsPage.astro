---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAllProjects, countProjectsUsing } from "@data/projects";
import { getTechnologies, GROUP_ORDER, GROUP_TITLES } from "@data/technologies";
import { CATEGORIES, categoryMeta, contextLabel } from "@data/categories";
import ProjectsExplorer from "@components/svelte/ProjectsExplorer.svelte";
import MainLayout from "@layouts/MainLayout.astro";
import trans, { techSkills, schoolSkills } from "@i18n";

const lang = Astro.locals.lang;
const [projects, technologies] = await Promise.all([getAllProjects(), getTechnologies()]);
const searchParams = Astro.url.searchParams;
const techColors = Object.fromEntries(technologies.map(t => [t.name, t.color]));

const explorerProjects = projects.map(p => ({
    slug: p.slug,
    href: getRelativeLocaleUrl(lang, `/projects/${p.slug}`),
    name: p.name[lang],
    year: p.year,
    date: p.date,
    desc: p.description[lang],
    thumb: p.thumb,
    categories: p.categories,
    featured: p.featured,
    teamIcon: p.teamSize === 1 ? "👤" : "👥",
    teamLabel: p.teamSize === 1 ? trans.common.solo[lang] : `${trans.common.teamof[lang]} ${p.teamSize}`,
    contextLabel: contextLabel(p.context, lang),
    techs: p.techs.map(t => t.name),
    cats: p.categories.map(c => {
        const meta = categoryMeta(c);
        return { key: c, label: meta.single[lang], dot: meta.dot };
    }),
}));

const pills = [
    {
        key: "featured",
        label: trans.projects.featuredpill[lang],
        dot: "#F9DA08",
        count: projects.filter(p => p.featured).length,
    },
    {
        key: "all",
        label: trans.projects.allpill[lang],
        dot: "#87b3f6",
        count: projects.length,
    },
    ...Object.entries(CATEGORIES).map(([key, meta]) => ({
        key,
        label: meta.label[lang],
        dot: meta.dot,
        count: projects.filter(p => p.categories.includes(key as keyof typeof CATEGORIES)).length,
    })),
];

const projectCountLabel = (count: number) =>
    `${count} ${count === 1 ? trans.projects.project[lang] : trans.projects.projectcount[lang]}`;

const skillGroups = GROUP_ORDER.map(group => {
    const items = technologies
        .filter(t => t.group === group)
        .map(t => {
            const count = countProjectsUsing(projects, t.name);
            return {
                n: t.name,
                c: t.color,
                count,
                countLabel: projectCountLabel(count),
            };
        })
        .sort((a, b) => b.count - a.count || a.n.localeCompare(b.n));
    return {
        title: GROUP_TITLES[group][lang],
        countLabel: `${items.length} ${trans.projects.technologies[lang]}`,
        items,
    };
});

const labels = {
    searchPlaceholder: trans.projects.searchplaceholder[lang],
    sortNewest: trans.projects.sortnewest[lang],
    sortOldest: trans.projects.sortoldest[lang],
    result: trans.projects.result[lang],
    results: trans.projects.results[lang],
    builtWith: trans.projects.builtwith[lang],
    clickToFilter: trans.projects.clicktofilter[lang],
    removeTechFilter: trans.projects.removetechfilter[lang],
    noProject: trans.projects.noprojectfound[lang],
    showAll: trans.projects.showallprojects[lang],
    details: trans.common.details[lang],
    techSkillsTitle: trans.projects.mytechskills[lang],
    techSkillsIntro: trans.projects.techskillsintro[lang],
};

// Restore a shareable state from the URL (?filter=web&tech=Svelte&q=...).
const validFilters = pills.map(p => p.key);
const filterParam = searchParams.get("filter") ?? "";
const techParam = searchParams.get("tech") ?? "";
const initialFilter = validFilters.includes(filterParam) ? filterParam : "featured";
const initialTech = technologies.some(t => t.name === techParam) ? techParam : null;
const initialQuery = searchParams.get("q") ?? "";

// The year range follows the actual projects instead of a hardcoded copy
// (computed from the already-loaded list, so it never goes stale).
const years = projects.map(p => p.year);
const currentYear = new Date().getFullYear();
const subtitle = trans.projects.subtitle[lang]
    .replace("{count}", `${projects.length}`)
    .replace("{from}", `${years.length > 0 ? Math.min(...years) : currentYear}`)
    .replace("{to}", `${years.length > 0 ? Math.max(...years) : currentYear}`);

// The heading follows the active filter pill (rendered inside the island so
// it updates live; the SSR output already matches the ?filter= of the URL).
const titles: Record<string, string> = {
    featured: trans.projects.featuredtitle[lang],
    all: trans.projects.allmyprojects[lang],
    ...Object.fromEntries(Object.entries(CATEGORIES).map(([key, meta]) => [key, meta.title[lang]])),
};
---

<MainLayout title={trans.projects.title[lang]} description={trans.projects.description[lang]}>
    <main id="main-content" class="w-full max-w-415 mx-auto">
        <ProjectsExplorer
            projects={explorerProjects}
            {pills}
            {titles}
            {subtitle}
            {techColors}
            skillHighlights={techSkills.map(s => s[lang])}
            {skillGroups}
            {labels}
            {initialFilter}
            {initialTech}
            {initialQuery}
            client:idle
        />

        <!-- education & teamwork -->
        <section class="px-page pt-8 pb-14">
            <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-4">
                <div class="surface-card py-5.5 px-6">
                    <h2 class="text-[13px] font-bold text-accent-heading mb-2.5">{trans.projects.educationtitle[lang]}</h2>
                    <p class="text-[12.5px] leading-[1.85] text-body">{trans.projects.education[lang]}</p>
                </div>
                <div class="surface-card py-5.5 px-6">
                    <h2 class="text-[13px] font-bold text-accent-heading mb-3">{trans.projects.teamskillstitle[lang]}</h2>
                    <ul class="flex flex-col gap-2.5">
                        {schoolSkills.map(skill => (
                            <li class="flex gap-2 text-xs leading-[1.6] text-body"><span aria-hidden="true">🏅</span><span>{skill[lang]}</span></li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>
    </main>
</MainLayout>
