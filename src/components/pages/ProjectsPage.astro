---
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { countProjectsUsing, projectsYearRange } from "@data/projects";
import { GROUP_ORDER, GROUP_TITLES } from "@data/technologies";
import type { Project, Technology } from "@data/models";
import { CATEGORIES, categoryMeta, contextLabel } from "@data/categories";
import ProjectsExplorer from "@components/svelte/ProjectsExplorer.svelte";
import MainLayout from "@layouts/MainLayout.astro";
import type { PlanetPlacement } from "@lib/space/planets";
import trans, { techSkills, schoolSkills } from "@i18n";

interface Props {
    projects: Project[];
    technologies: Technology[];
}

// Loaded by the route, which answers 503 when PocketBase is unreachable
const { projects, technologies } = Astro.props;
const lang = Astro.locals.lang;
const searchParams = Astro.url.searchParams;
const techColors = Object.fromEntries(technologies.map(t => [t.name, t.color]));

const explorerProjects = projects.map(p => ({
    slug: p.slug,
    href: getRelativeLocaleUrl(lang, `/projects/${p.slug}`),
    name: p.name[lang],
    year: p.year,
    date: p.date,
    desc: p.description[lang],
    thumb: p.thumb,
    thumbVideo: p.thumbVideo,
    categories: p.categories,
    featured: p.featured,
    solo: p.teamSize === 1,
    teamLabel: p.teamSize === 1 ? trans.common.solo[lang] : `${trans.common.teamof[lang]} ${p.teamSize}`,
    contextLabel: contextLabel(p.context, lang),
    techs: p.techs.map(t => t.name),
    cats: p.categories.map(c => {
        const meta = categoryMeta(c);
        return { key: c, label: meta.single[lang], dot: meta.dot };
    }),
}));

const pills = [
    {
        key: "featured",
        label: trans.projects.featuredpill[lang],
        dot: "#FFE3B0",
        count: projects.filter(p => p.featured).length,
    },
    {
        key: "all",
        label: trans.projects.allpill[lang],
        dot: "#78A8FF",
        count: projects.length,
    },
    ...Object.entries(CATEGORIES).map(([key, meta]) => ({
        key,
        label: meta.label[lang],
        dot: meta.dot,
        count: projects.filter(p => p.categories.includes(key as keyof typeof CATEGORIES)).length,
    })),
];

const projectCountLabel = (count: number) =>
    `${count} ${count === 1 ? trans.projects.project[lang] : trans.projects.projectcount[lang]}`;

const skillGroups = GROUP_ORDER.map(group => {
    const items = technologies
        .filter(t => t.group === group)
        .map(t => {
            const count = countProjectsUsing(projects, t.name);
            return {
                n: t.name,
                c: t.color,
                count,
                countLabel: projectCountLabel(count),
            };
        })
        .sort((a, b) => b.count - a.count || a.n.localeCompare(b.n));
    return {
        title: GROUP_TITLES[group][lang],
        countLabel: `${items.length} ${trans.projects.technologies[lang]}`,
        items,
    };
});

const t = trans.projects;
const labels = {
    eyebrow: t.eyebrow[lang],
    filters: t.filters[lang],
    searchPlaceholder: t.searchplaceholder[lang],
    sortLabel: t.sortlabel[lang],
    sortNewest: t.sortnewest[lang],
    sortOldest: t.sortoldest[lang],
    result: t.result[lang],
    results: t.results[lang],
    builtWith: t.builtwith[lang],
    clickToFilter: t.clicktofilter[lang],
    removeTechFilter: t.removetechfilter[lang],
    noProject: t.noprojectfound[lang],
    showAll: t.showallprojects[lang],
    details: trans.common.details[lang],
    skillsEyebrow: t.skillseyebrow[lang],
    techSkillsTitle: t.mytechskills[lang],
    techSkillsIntro: t.techskillsintro[lang],
    showcase: t.showcasecta[lang],
    showcaseHint: t.showcasehint[lang],
};

// Restore a shareable state from the URL (?filter=web&tech=Svelte&q=...).
const validFilters = pills.map(p => p.key);
const filterParam = searchParams.get("filter") ?? "";
const techParam = searchParams.get("tech") ?? "";
const initialFilter = validFilters.includes(filterParam) ? filterParam : "featured";
const initialTech = technologies.some(tech => tech.name === techParam) ? techParam : null;
const initialQuery = searchParams.get("q") ?? "";

// The year range follows the actual projects instead of a hardcoded copy
// (computed from the already-loaded list, so it never goes stale).
const currentYear = new Date().getFullYear();
const range = projectsYearRange(projects) ?? { from: currentYear, to: currentYear };
const subtitle = t.subtitle[lang]
    .replace("{count}", `${projects.length}`)
    .replace("{from}", `${range.from}`)
    .replace("{to}", `${range.to}`);

// The heading follows the active filter pill (rendered inside the island so
// it updates live; the SSR output already matches the ?filter= of the URL).
const titles: Record<string, string> = {
    featured: t.featuredtitle[lang],
    all: t.allmyprojects[lang],
    ...Object.fromEntries(Object.entries(CATEGORIES).map(([key, meta]) => [key, meta.title[lang]])),
};

const planets: PlanetPlacement[] = [
    { name: "saturn", anchor: "#projects-head", at: 0.22, x: 0.86, mAt: -0.16, mx: 0.82 },
    { name: "jupiter", anchor: "#skills", at: 0.25, x: -0.05, mAt: 0.05, mx: 0.04 },
];
---

<MainLayout title={t.title[lang]} description={t.description[lang]} {planets}>
    <main id="main-content" tabindex="-1">
        <ProjectsExplorer
            projects={explorerProjects}
            {pills}
            {titles}
            {subtitle}
            {techColors}
            skillHighlights={techSkills.map(s => s[lang])}
            {skillGroups}
            {labels}
            showcaseHref={getRelativeLocaleUrl(lang, "/showcase")}
            {initialFilter}
            {initialTech}
            {initialQuery}
            client:idle
        />

        <!-- education & teamwork -->
        <section class="section pt-0!" aria-label={`${t.educationtitle[lang]}, ${t.teamskillstitle[lang]}`}>
            <div class="wrap background">
                <div class="card reveal panel">
                    <span class="seal" aria-hidden="true"><Icon name="graduation-cap" class="size-6" /></span>
                    <h2 class="heading-6">{t.educationtitle[lang]}</h2>
                    <p class="body-6">{t.education[lang]}</p>
                </div>
                <div class="card reveal panel" style="--d:80ms">
                    <span class="seal" aria-hidden="true"><Icon name="handshake" class="size-6" /></span>
                    <h2 class="heading-6">{t.teamskillstitle[lang]}</h2>
                    <ul class="checks body-6">
                        {schoolSkills.map(skill => (
                            <li><Icon name="check-circle" class="size-5" />{skill[lang]}</li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>
    </main>
</MainLayout>

<style>
    .background {
        display: grid;
        gap: 24px;
        grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    }

    .panel {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    @media (min-width: 1024px) {
        .panel { padding: 32px; }
    }

    .seal {
        width: 48px;
        height: 48px;
        border-radius: 9999px;
        display: grid;
        place-items: center;
        background: var(--accent-soft);
        color: var(--accent-text);
        border: 1px solid var(--accent-line);
        margin-bottom: 8px;
    }

    .checks {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .checks li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        color: var(--heading);
    }

    .checks :global(svg) {
        color: var(--accent-text);
        flex-shrink: 0;
    }
</style>
