---
import type { Project } from "@data/models";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAdjacentProjects, getProjectBadge } from "@data/projects";
import { CONTEXTS, PROJECT_TYPES, TECH_ROLES } from "@data/categories";
import MainLayout from "@layouts/MainLayout.astro";
import trans from "@i18n";

interface Props {
    project: Project;
}

const { project } = Astro.props;
const lang = Astro.locals.lang;
const name = project.name[lang];
const { prev, next } = await getAdjacentProjects(project.slug);
const projectsUrl = getRelativeLocaleUrl(lang, "/projects");
const teamLabel = project.teamSize === 1 ? trans.common.solo[lang] : `${trans.common.teamof[lang]} ${project.teamSize}`;
const languagesLabel = project.languages.map(l => l.toUpperCase()).join(" · ");
const chips = [
    getProjectBadge(project),
    CONTEXTS[project.context][lang],
    project.date,
    teamLabel,
    languagesLabel,
];
const detailRows = [
    { label: trans.detail.year[lang], value: project.date },
    { label: trans.detail.type[lang], value: PROJECT_TYPES[project.type][lang] },
    { label: trans.detail.team[lang], value: teamLabel },
    { label: trans.detail.context[lang], value: CONTEXTS[project.context][lang] },
    { label: trans.detail.languages[lang], value: languagesLabel },
];
---

<MainLayout title={`${trans.common.title[lang]} - ${name}`} description={project.description[lang]}>
    <main class="pt-[26px] px-page pb-11 max-w-[1660px] mx-auto">
        <nav class="text-[11.5px] text-muted mb-4" aria-label={trans.detail.allprojects[lang]}>
            <a href={projectsUrl} class="text-accent font-bold">‹ {trans.detail.allprojects[lang]}</a>
            <span class="mx-2">/</span>
            <span>{name}</span>
        </nav>

        <div class="flex justify-between items-start mb-[22px] gap-5 flex-wrap">
            <div>
                <h1 class="text-[34px] font-bold mb-3 text-heading glow">{name}</h1>
                <div class="flex gap-2 flex-wrap">
                    {chips.map(chip => (
                        <span class="text-[11px] font-bold text-chip-text bg-chip border border-edge-strong rounded-full py-1.5 px-3">{chip}</span>
                    ))}
                </div>
            </div>
            <div class="flex gap-2.5 flex-wrap">
                {project.link && (
                    <a href={project.link} target="_blank" rel="noopener" class="btn-primary text-[12.5px] py-3 px-[22px] shadow-btn-glow">{trans.detail.visit[lang]}</a>
                )}
                {project.github && (
                    <a href={project.github} target="_blank" rel="noopener" class="btn-outline text-[12.5px] py-[11px] px-5">{trans.detail.githubrepo[lang]}</a>
                )}
            </div>
        </div>

        <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-[22px] items-start">
            <div class="flex flex-col gap-[18px]">
                <section class="surface-card py-[22px] px-6">
                    <h2 class="text-[13px] font-bold text-accent-heading mb-2.5">{trans.detail.aboutproject[lang]}</h2>
                    <p class="text-[13px] leading-[1.8] text-body">{project.about[lang]}</p>
                </section>
                <figure class="surface-card overflow-hidden">
                    <img src={project.thumbLarge} alt={project.caption[lang]} loading="lazy" decoding="async" class="w-full aspect-video object-cover" />
                    <figcaption class="py-[11px] px-4 text-[11px] text-muted border-t border-edge">📷 {project.caption[lang]}</figcaption>
                </figure>
            </div>

            <div class="flex flex-col gap-3.5">
                <section class="surface-card py-[18px] px-5">
                    <h2 class="text-xs font-bold text-accent-heading mb-3">{trans.detail.techstack[lang]}</h2>
                    <ul class="flex flex-col gap-2">
                        {project.techs.map(tech => (
                            <li class="flex items-center gap-[9px] text-xs font-semibold text-heading">
                                <span class="w-2 h-2 rounded-full shrink-0" style={`background:${tech.color}`} />
                                {tech.name}
                                <span class="ml-auto text-[10px] text-muted font-normal">{TECH_ROLES[tech.role][lang]}</span>
                            </li>
                        ))}
                    </ul>
                </section>

                <section class="surface-card py-[18px] px-5">
                    <h2 class="text-xs font-bold text-accent-heading mb-3">{trans.common.details[lang]}</h2>
                    <dl class="flex flex-col gap-[9px] text-[11.5px]">
                        {detailRows.map(row => (
                            <div class="flex justify-between gap-4">
                                <dt class="text-muted">{row.label}</dt>
                                <dd class="font-bold text-heading text-right">{row.value}</dd>
                            </div>
                        ))}
                    </dl>
                </section>

                <nav class="bg-[rgba(97,156,243,.12)] border border-[rgba(97,156,243,.35)] rounded-[13px] py-[18px] px-5" aria-label={trans.detail.moreprojects[lang]}>
                    <h2 class="text-xs font-bold mb-2.5 text-heading">{trans.detail.moreprojects[lang]}</h2>
                    <div class="flex justify-between gap-4 text-xs font-bold">
                        <a href={getRelativeLocaleUrl(lang, `/projects/${prev.slug}`)} class="text-accent hover:underline">‹ {prev.name[lang]}</a>
                        <a href={getRelativeLocaleUrl(lang, `/projects/${next.slug}`)} class="text-accent hover:underline text-right">{next.name[lang]} ›</a>
                    </div>
                </nav>
            </div>
        </div>
    </main>
</MainLayout>
