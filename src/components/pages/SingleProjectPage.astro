---
import type { Project } from "@data/models";
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAdjacentProjects } from "@data/projects";
import { categoryMeta, contextLabel, techRoleLabel } from "@data/categories";
import MainLayout from "@layouts/MainLayout.astro";
import { isVideo } from "@data/media";
import trans from "@i18n";

interface Props {
    project: Project;
}

const { project } = Astro.props;
const lang = Astro.locals.lang;
const name = project.name[lang];
const { prev, next } = await getAdjacentProjects(project.slug);
const projectsUrl = getRelativeLocaleUrl(lang, "/projects");
const teamLabel = project.teamSize === 1 ? trans.common.solo[lang] : `${trans.common.teamof[lang]} ${project.teamSize}`;
const languagesLabel = project.languages.map(l => l.toUpperCase()).join(" · ");
const categoryNames = project.categories.map(c => categoryMeta(c).single[lang]);
const categoriesLabel = categoryNames.join(" · ");
const context = contextLabel(project.context, lang);
const chips = [
    ...categoryNames,
    context,
    project.date,
    teamLabel,
    languagesLabel,
];
// The gallery shows every picture of the project, each with its own
// caption (also used as the alt text); pictures without one fall back
// to the project's legacy thumbnail caption.
const gallery = project.pictures.map(picture => ({
    url: picture.url,
    video: isVideo(picture.url),
    caption: picture.caption[lang] || project.caption[lang],
}));
const detailRows = [
    { label: trans.detail.year[lang], value: project.date },
    { label: trans.detail.categories[lang], value: categoriesLabel },
    { label: trans.detail.team[lang], value: teamLabel },
    { label: trans.detail.context[lang], value: context },
    { label: trans.detail.languages[lang], value: languagesLabel },
];
---

<MainLayout title={`${trans.common.title[lang]} - ${name}`} description={project.description[lang]} image={project.thumbLarge}>
    <main id="main-content" class="pt-6.5 px-page pb-11 w-full max-w-415 mx-auto">
        <nav class="text-sm text-muted mb-4" aria-label={trans.detail.allprojects[lang]}>
            <a href={projectsUrl} class="text-accent font-bold">‹ {trans.detail.allprojects[lang]}</a>
            <span class="mx-2">/</span>
            <span>{name}</span>
        </nav>

        <div class="flex justify-between items-start mb-5.5 gap-5 flex-wrap">
            <div>
                <h1 class="text-3xl font-bold mb-3 text-heading">{name}</h1>
                <div class="flex gap-2 flex-wrap">
                    {chips.map(chip => (
                        <span class="text-xs font-bold text-chip-text bg-chip border border-edge-strong rounded-full py-1.5 px-3">{chip}</span>
                    ))}
                </div>
            </div>
            <div class="flex gap-2.5 flex-wrap">
                {project.link && (
                    <a href={project.link} target="_blank" rel="noopener" aria-label={`${trans.detail.visit[lang]} (${trans.common.newwindow[lang]})`} class="btn-primary text-sm py-3 px-5.5 shadow-btn-glow">{trans.detail.visit[lang]}</a>
                )}
                {project.github && (
                    <a href={project.github} target="_blank" rel="noopener" aria-label={`${trans.detail.githubrepo[lang]} (${trans.common.newwindow[lang]})`} class="btn-outline text-sm py-2.75 px-5">{trans.detail.githubrepo[lang]}</a>
                )}
            </div>
        </div>

        <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-5.5 items-start">
            <div class="flex flex-col gap-4.5">
                <section class="surface-card py-5.5 px-6">
                    <h2 class="text-lg font-bold text-accent-heading mb-3">{trans.detail.aboutproject[lang]}</h2>
                    <p class="text-base text-body">{project.about[lang]}</p>
                </section>
                {gallery.map(media => (
                    <figure class="surface-card overflow-hidden">
                        {media.video ? (
                            <video src={media.url} controls muted playsinline preload="metadata" aria-label={media.caption} class="w-full aspect-video object-contain bg-[#04101f]" />
                        ) : (
                            <div class="relative aspect-video overflow-hidden">
                                <img src={media.url} alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover scale-110 blur-lg opacity-70" />
                                <img src={media.url} alt={media.caption} loading="lazy" decoding="async" class="relative w-full h-full object-contain" />
                            </div>
                        )}
                        <figcaption class="flex items-center gap-2 py-2.75 px-4 text-xs text-muted border-t border-edge">
                            <Icon name={media.video ? "film" : "camera"} class="text-sm shrink-0" aria-hidden="true" />
                            {media.caption}
                        </figcaption>
                    </figure>
                ))}
            </div>

            <div class="flex flex-col gap-3.5">
                <section class="surface-card py-4.5 px-5">
                    <h2 class="text-lg font-bold text-accent-heading mb-3.5">{trans.detail.techstack[lang]}</h2>
                    <ul class="flex flex-col gap-2">
                        {project.techs.map(tech => (
                            <li class="flex items-center gap-2.25 text-sm leading-tight font-semibold text-heading">
                                <span class="w-2 h-2 rounded-full shrink-0" style={`background:${tech.color}`} />
                                {tech.name}
                                <span class="ml-auto text-xs text-muted font-normal">{techRoleLabel(tech.role, lang)}</span>
                            </li>
                        ))}
                    </ul>
                </section>

                <section class="surface-card py-4.5 px-5">
                    <h2 class="text-lg font-bold text-accent-heading mb-3.5">{trans.common.details[lang]}</h2>
                    <dl class="flex flex-col gap-2.5 text-sm leading-tight">
                        {detailRows.map(row => (
                            <div class="flex justify-between gap-4">
                                <dt class="text-muted">{row.label}</dt>
                                <dd class="font-bold text-heading text-right">{row.value}</dd>
                            </div>
                        ))}
                    </dl>
                </section>

                {prev && next && (
                    <nav class="bg-[rgba(97,156,243,.12)] border border-[rgba(97,156,243,.35)] rounded-[13px] py-4.5 px-5" aria-label={trans.detail.moreprojects[lang]}>
                        <h2 class="text-lg font-bold mb-3 text-heading">{trans.detail.moreprojects[lang]}</h2>
                        <div class="flex justify-between gap-4 text-sm font-bold">
                            <a href={getRelativeLocaleUrl(lang, `/projects/${prev.slug}`)} class="text-accent hover:underline">‹ {prev.name[lang]}</a>
                            <a href={getRelativeLocaleUrl(lang, `/projects/${next.slug}`)} class="text-accent hover:underline text-right">{next.name[lang]} ›</a>
                        </div>
                    </nav>
                )}
            </div>
        </div>
    </main>
</MainLayout>
