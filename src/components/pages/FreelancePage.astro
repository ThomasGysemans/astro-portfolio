---
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getProfessionalProjects, getAllProjects } from "@data/projects";
import AvailabilityBadge from "@components/AvailabilityBadge.astro";
import ProjectCard from "@components/ProjectCard.astro";
import MainLayout from "@layouts/MainLayout.astro";
import StatCard from "@components/StatCard.astro";
import { getReviews } from "@data/reviews";
import trans from "@i18n";

const EMAIL = "contact@thomasgysemans.dev";
const MALT_URL = "https://malt.fr/profile/thomasgysemans";

// Starting price of a showcase website, in euros, for the budget block.
// While it is null the whole "how much does it cost" section is skipped, so
// the page can never ship with a placeholder figure in front of a prospect.
// Set it to a real number to switch the block on — that is the only change
// needed, the copy and the layout are already in place.
const STARTING_PRICE: number | null = 500;

const lang = Astro.locals.lang;
const [freelanceProjects, allProjects, reviews] = await Promise.all([
    getProfessionalProjects(),
    getAllProjects(),
    getReviews(),
]);
const totalProjects = allProjects.length;
const allProjectsLabel = trans.home.allprojectscount[lang].replace("{count}", `${totalProjects}`);
const projectsUrl = getRelativeLocaleUrl(lang, "/projects");
// Year of the oldest project, for the "shipped since {year}" stat.
const firstYear = allProjects.length > 0 ? Math.min(...allProjects.map(p => p.year)) : new Date().getFullYear();

const steps = [
    { icon: "palette", border: "#619cf3", title: trans.freelance.step1title[lang], text: trans.freelance.step1[lang], fade: ".2s", pulse: ".4s" },
    { icon: "flask-conical", border: "#87b3f6", title: trans.freelance.step2title[lang], text: trans.freelance.step2[lang], fade: "1.1s", pulse: "1.3s" },
    { icon: "rocket", border: "#2fa866", title: trans.freelance.step3title[lang], text: trans.freelance.step3[lang], fade: "2s", pulse: "2.2s" },
];

const aiPoints = [
    { icon: "zap", label: trans.freelance.ai1a[lang], result: trans.freelance.ai1b[lang] },
    { icon: "search", label: trans.freelance.ai2a[lang], result: trans.freelance.ai2b[lang] },
    { icon: "eye", label: trans.freelance.ai3a[lang], result: trans.freelance.ai3b[lang] },
    { icon: "list-checks", label: trans.freelance.ai4a[lang], result: trans.freelance.ai4b[lang] },
];

// Currency formatting follows the locale: "1 200 €" in French, "€1,200" in
// English, rather than a hardcoded string repeated in both translations.
const priceFrom = STARTING_PRICE === null ? null : trans.freelance.price1from[lang].replace(
    "{price}",
    new Intl.NumberFormat(lang === "fr" ? "fr-FR" : "en-GB", {
        style: "currency",
        currency: "EUR",
        maximumFractionDigits: 0,
    }).format(STARTING_PRICE),
);

const carePoints = [
    { icon: "accessibility", label: trans.freelance.care1a[lang], result: trans.freelance.care1b[lang] },
    { icon: "lock", label: trans.freelance.care2a[lang], result: trans.freelance.care2b[lang] },
];
---

<MainLayout title={trans.freelance.title[lang]} description={trans.freelance.description[lang]}>
    <main id="main-content" class="relative overflow-hidden">
        <div class="hero-scene absolute inset-0 pointer-events-none" aria-hidden="true" />

        <div class="relative max-w-415 mx-auto">
            <!-- hero + process timeline -->
            <section class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-[clamp(28px,4vw,72px)] pt-[clamp(40px,6vw,88px)] px-page pb-12 items-center">
                <div>
                    <div class="mb-6.5">
                        <AvailabilityBadge />
                    </div>
                    <h1 class="text-[clamp(30px,3vw,48px)] font-bold leading-[1.18] m-0 text-heading" set:html={trans.freelance.herotitle[lang]} />
                    <p class="text-lg leading-[1.7] text-body mt-4.5 max-w-125">{trans.freelance.herointro[lang]}</p>
                    <div class="flex items-center gap-3 mt-8.5 flex-wrap">
                        <a href={`mailto:${EMAIL}`} class="btn-primary inline-flex items-center gap-2 text-base py-3.25 px-6.5 shadow-btn-glow">
                            <Icon name="mail" class="text-base" />
                            {trans.freelance.emailme[lang]}
                        </a>
                        <a href={MALT_URL} target="_blank" rel="noopener" aria-label={`${trans.freelance.hireonmalt[lang]} (${trans.common.newwindow[lang]})`} class="malt-btn">
                            <Icon name="malt" class="text-base text-malt" />
                            {trans.freelance.hireonmalt[lang]}
                        </a>
                    </div>
                    <p class="text-sm text-muted mt-4">{trans.freelance.freequote[lang]}</p>
                </div>

                <div class="fl-timeline relative max-w-100 w-full justify-self-center py-2.5">
                    <div class="fl-timeline-line absolute left-5.75 top-3.5 bottom-3.5 w-0.5 bg-edge-strong" aria-hidden="true" />
                    <div class="fl-timeline-line fl-timeline-progress absolute left-5.75 top-3.5 bottom-3.5 w-0.5" aria-hidden="true" />
                    <ol class="fl-steps relative flex flex-col gap-11">
                        {steps.map(step => (
                            <li class="fl-step flex gap-4.5 items-center" style={`animation-delay:${step.fade}`}>
                                <span class="fl-step-icon" style={`border-color:${step.border};animation-delay:${step.pulse}`} aria-hidden="true">
                                    <Icon name={step.icon} class="text-xl" style={`color:${step.border}`} />
                                </span>
                                <div>
                                    <div class="font-display text-lg font-bold text-heading">{step.title}</div>
                                    <div class="text-sm text-body mt-1">{step.text}</div>
                                </div>
                            </li>
                        ))}
                    </ol>
                </div>
            </section>

            <!-- stats -->
            <section class="grid grid-cols-[repeat(auto-fit,minmax(210px,1fr))] gap-5 px-page pt-8 pb-18">
                <StatCard value={trans.freelance.stat1num[lang]}>{trans.freelance.stat1[lang]}</StatCard>
                <StatCard value={`${freelanceProjects.length}`}>{trans.freelance.stat2[lang]}</StatCard>
                <StatCard value={trans.freelance.stat3num[lang]}>{trans.freelance.stat3[lang]}</StatCard>
                <StatCard value={`${totalProjects}`}>{trans.freelance.stat4[lang].replace("{year}", `${firstYear}`)}</StatCard>
            </section>

            <!-- guarantee + AI -->
            <section class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-5 px-page pb-20">
                <div class="bg-[rgba(47,168,102,.1)] border border-[rgba(47,168,102,.4)] rounded-[13px] py-8 px-8.5 flex gap-5.5 items-center">
                    <span class="w-14 h-14 rounded-full bg-card-solid border-2 border-[#2fa866] flex items-center justify-center shrink-0" aria-hidden="true">
                        <Icon name="shield-check" class="text-2xl text-[#2fa866]" />
                    </span>
                    <div>
                        <h2 class="text-xl font-bold m-0 text-heading">{trans.freelance.guaranteetitle[lang]}</h2>
                        <p class="text-sm text-body mt-1.5">{trans.freelance.guarantee[lang]}</p>
                    </div>
                </div>
                <div class="surface-card py-7 px-8.5">
                    <h2 class="text-xl font-bold mb-4 text-heading">{trans.freelance.aititle[lang]}</h2>
                    <ul class="flex flex-col gap-3.5 text-sm font-semibold text-body">
                        {aiPoints.map(point => (
                            <li class="flex items-center gap-2.5 flex-wrap">
                                <Icon name={point.icon} class="text-base text-accent shrink-0" aria-hidden="true" />
                                <span class="text-heading">{point.label}</span>
                                <span class="text-accent">{point.result}</span>
                            </li>
                        ))}
                    </ul>
                </div>
                <div class="surface-card py-7 px-8.5">
                    <h2 class="text-xl font-bold mb-4 text-heading">{trans.freelance.carestitle[lang]}</h2>
                    <ul class="flex flex-col gap-3.5 text-sm font-semibold text-body">
                        {carePoints.map(point => (
                            <li class="flex items-center gap-2.5 flex-wrap">
                                <Icon name={point.icon} class="text-base text-accent shrink-0" aria-hidden="true" />
                                <span class="text-heading">{point.label}</span>
                                <span class="text-accent">{point.result}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            </section>

            <!-- freelance projects -->
            <section class="px-page pb-20">
                <div class="flex justify-between items-baseline mb-7 gap-4 flex-wrap">
                    <h2 class="text-2xl font-bold m-0 text-heading">{trans.freelance.deliveredforclients[lang]}</h2>
                    <a href={projectsUrl} class="text-sm font-bold text-accent hover:underline hover:brightness-110">{allProjectsLabel}</a>
                </div>
                <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-5">
                    {freelanceProjects.map(project => (
                        <ProjectCard {project} variant="freelance" />
                    ))}
                </div>
            </section>

            <!-- reviews -->
            <section class="px-page pb-20">
                <h2 class="text-2xl font-bold mb-7 text-heading">{trans.freelance.reviewstitle[lang]}</h2>
                <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-5">
                    {reviews.map(review => (
                        <figure class="surface-card py-7 px-7 flex flex-col gap-3.5">
                            <div class="text-base tracking-[2px]">
                                <span class="text-accent" aria-hidden="true">{"★".repeat(review.rating)}<span class="text-muted">{"☆".repeat(5 - review.rating)}</span></span>
                                <span class="sr-only">{lang === "fr" ? `Note : ${review.rating} sur 5` : `Rating: ${review.rating} out of 5`}</span>
                            </div>
                            <!-- The quotation marks come from the page, not the data (localized style). -->
                            <blockquote class="text-base text-body">{lang === "fr" ? `« ${review.quote[lang]} »` : `“${review.quote[lang]}”`}</blockquote>
                            <figcaption class="mt-auto border-t border-edge pt-3 flex justify-between items-center gap-2.5">
                                <div class="text-xs text-muted leading-normal">
                                    {review.role[lang]}<br />
                                    <span class="font-bold text-heading text-xs">{review.company[lang]}</span>
                                    {lang === "en" && review.translated && (
                                        <span class="block text-xs italic text-muted">Translated from French</span>
                                    )}
                                </div>
                                <span class="text-xs font-bold text-accent border border-edge-strong rounded-full py-1 px-2.5 whitespace-nowrap">{review.year}</span>
                            </figcaption>
                        </figure>
                    ))}
                </div>
            </section>

            <!-- budget anchor: placed after the proof (projects, reviews) and
                 right before the ask, so the figure lands once the visitor is
                 already convinced. Skipped entirely while STARTING_PRICE is null. -->
            {priceFrom && (
                <section class="px-page pb-20">
                    <h2 class="text-2xl font-bold mb-7 text-heading">{trans.freelance.pricingtitle[lang]}</h2>
                    <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-5 max-w-215">
                        <div class="surface-card py-7 px-7">
                            <h3 class="text-lg font-bold text-heading m-0">{trans.freelance.price1label[lang]}</h3>
                            <p class="font-display text-2xl font-bold text-accent mt-2">{priceFrom}</p>
                            <p class="text-sm text-body mt-2.5">{trans.freelance.price1desc[lang]}</p>
                        </div>
                        <div class="surface-card py-7 px-7">
                            <h3 class="text-lg font-bold text-heading m-0">{trans.freelance.price2label[lang]}</h3>
                            <p class="font-display text-2xl font-bold text-accent mt-2">{trans.freelance.price2value[lang]}</p>
                            <p class="text-sm text-body mt-2.5">{trans.freelance.price2desc[lang]}</p>
                        </div>
                    </div>
                    <p class="text-sm text-muted mt-5 max-w-215">{trans.freelance.pricingnote[lang]}</p>
                </section>
            )}

            <!-- contact -->
            <section class="px-page pb-22">
                <div class="bg-[rgba(97,156,243,.12)] border border-[rgba(97,156,243,.35)] rounded-2xl py-10 px-11 flex items-center justify-between gap-6 flex-wrap">
                    <div>
                        <h2 class="text-2xl font-bold text-heading m-0">{trans.freelance.ctatitle[lang]}</h2>
                        <p class="text-base text-body mt-2">{trans.freelance.ctasubtitle[lang]}</p>
                    </div>
                    <div class="flex gap-3 flex-wrap">
                        <a href={`mailto:${EMAIL}`} class="btn-primary inline-flex items-center gap-2 text-base py-3.25 px-6 shadow-btn-glow">
                            <Icon name="mail" class="text-base" />
                            {EMAIL}
                        </a>
                        <a href={MALT_URL} target="_blank" rel="noopener" aria-label={`${trans.freelance.onmalt[lang]} (${trans.common.newwindow[lang]})`} class="malt-btn">
                            <Icon name="malt" class="text-base text-malt" />
                            {trans.freelance.onmalt[lang]}
                        </a>
                    </div>
                </div>
            </section>
        </div>
    </main>
</MainLayout>

<style lang="scss">
    @reference "../../styles/tailwind.css";

    .hero-scene {
        opacity: var(--hero-scene);
        transition: opacity .3s;
        background:
            radial-gradient(ellipse 60% 50% at 75% 30%, rgba(97, 156, 243, .14), transparent 65%),
            linear-gradient(180deg, rgba(3, 15, 32, .3), #030F20 82%);
    }

    .malt-btn {
        @apply inline-flex items-center gap-2 border-[1.5px] border-malt text-heading text-base font-bold py-3 px-5.5 rounded-[9px] whitespace-nowrap;
        transition: background .2s, transform .2s;

        &:hover {
            background: rgba(252, 87, 87, .12);
            transform: translateY(-2px);
        }
    }

    @keyframes fl-grow {
        from { transform: scaleY(0); }
        to { transform: scaleY(1); }
    }

    @keyframes fl-fade {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fl-pulse {
        0% { box-shadow: 0 0 0 0 rgba(97, 156, 243, .55); }
        100% { box-shadow: 0 0 0 14px rgba(97, 156, 243, 0); }
    }

    .fl-timeline-progress {
        background: linear-gradient(180deg, #619cf3, #2fa866);
        transform-origin: top;
        animation: fl-grow 2.2s ease .4s both;
    }

    .fl-step {
        animation: fl-fade .6s ease both;
    }

    .fl-step-icon {
        @apply w-12 h-12 rounded-full bg-card-solid border-2 flex items-center justify-center shrink-0;
        animation: fl-pulse 1.4s ease;
    }

    // Compact horizontal strip on small screens.
    @media (max-width: 900px) {
        .fl-timeline {
            max-width: 100%;
            justify-self: stretch;
        }

        .fl-timeline-line {
            display: none;
        }

        .fl-steps {
            flex-direction: row;
            gap: 14px;
            align-items: flex-start;
        }

        .fl-step {
            flex: 1;
            flex-direction: column;
            text-align: center;
            gap: 10px;
        }
    }

    // Very small screens: the steps stack vertically again.
    @media (max-width: 520px) {
        .fl-steps {
            flex-direction: column;
            gap: 22px;
        }

        .fl-step {
            flex-direction: row;
            text-align: left;
            gap: 16px;
            align-items: center;
        }
    }
</style>
