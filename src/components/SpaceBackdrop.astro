---
// The sky behind every public page: the starfield, a few twinkling stars, and
// the planets of the page (each page decides which bodies it shows, and where).
// All of it is fixed behind the content (z-index 0) and decorative.
import type { PlanetPlacement } from "@lib/space/planets";

interface Props {
    planets?: PlanetPlacement[];
}

const { planets = [] } = Astro.props;
---

<canvas class="sky" data-sky aria-hidden="true"></canvas>
<div class="twinkles" data-twinkles aria-hidden="true"></div>
{planets.length > 0 && (
    <canvas class="planets" data-planets={JSON.stringify(planets)} aria-hidden="true"></canvas>
)}

<style>
    .sky {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        z-index: 0;
        pointer-events: none;
    }

    .twinkles {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .twinkles :global(.tw) {
        position: absolute;
        width: 2px;
        height: 2px;
        border-radius: 9999px;
        background: #FFFFFF;
        box-shadow: 0 0 6px 1px rgb(160 195 255 / 0.8);
        animation: twinkle var(--dur, 3s) var(--ease-space) var(--del, 0s) infinite alternate;
    }

    :global(:root[data-motion="reduce"]) .twinkles :global(.tw) {
        opacity: 0.6;
    }

    @keyframes twinkle {
        from { opacity: 0.12; transform: scale(0.6); }
        to { opacity: 1; transform: scale(1.2); }
    }

    /* Above the stars (later in the source, same layer). lvh: the tallest
       viewport, so a phone toolbar sliding away never resizes it. */
    .planets {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        height: 100lvh;
        z-index: 0;
        pointer-events: none;
    }
</style>

<script>
    import { mountSky } from "@lib/space/sky";
    import { mountPlanets, type PlanetPlacement } from "@lib/space/planets";

    const sky = document.querySelector<HTMLCanvasElement>("[data-sky]");
    const twinkles = document.querySelector<HTMLElement>("[data-twinkles]");
    if (sky && twinkles) mountSky(sky, twinkles);

    const planets = document.querySelector<HTMLCanvasElement>("[data-planets]");
    if (planets) mountPlanets(planets, JSON.parse(planets.dataset.planets ?? "[]") as PlanetPlacement[]);
</script>
