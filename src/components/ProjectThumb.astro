---
// Presentation media of a project, as it appears on every card of the site:
// the picture letterboxed over a blurred copy of itself, so a 4:3 or a
// portrait thumbnail still fills the 16:9 frame without being cropped.
//
// When the project carries a `thumbVideo`, the picture becomes the video's
// poster and the video plays in its place — muted, looping, and only while
// the card is on screen (see `@lib/thumb-video`). The blurred backdrop stays
// the still image: a second decoded video stream for a background nobody
// looks at is not worth the frames.

interface Props {
    thumb: string; // ~800px wide
    // The ~1200px version, for the cards that get wide on large screens. The
    // browser then picks one of the two from `sizes` (the card's width).
    large?: string;
    sizes?: string;
    video?: string;
    alt: string;
    // Extra classes for the frame (the compact and freelance cards differ).
    class?: string;
}

const { thumb, large, sizes, video, alt, class: className } = Astro.props;
// A poster cannot choose between sizes: under a video, the backdrop and the
// poster share the larger picture (one download for both). Otherwise the two
// pictures share the same candidates, for the same reason.
const picture = video ? large ?? thumb : thumb;
const srcset = !video && large ? `${thumb} 800w, ${large} 1200w` : undefined;
---

<div class:list={["relative aspect-video overflow-hidden", className]}>
    <img src={picture} srcset={srcset} sizes={srcset && sizes} alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover scale-110 blur-lg opacity-70" />
    {video ? (
        <video
            data-thumb-video
            data-src={video}
            poster={picture}
            muted
            loop
            playsinline
            preload="none"
            aria-label={alt}
            class="relative w-full h-full object-contain"
        ></video>
    ) : (
        <img src={picture} srcset={srcset} sizes={srcset && sizes} alt={alt} loading="lazy" decoding="async" class="relative w-full h-full object-contain" />
    )}
    <slot />
</div>

<script>
    // Hoisted and bundled once per page by Astro, however many cards there are.
    import { mountThumbVideos } from "@lib/thumb-video";

    mountThumbVideos();
</script>
