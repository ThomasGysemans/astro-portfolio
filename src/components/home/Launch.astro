---
// The final call to action. The form sends the quote request to Thomas's inbox
// through the `sendQuote` action (src/actions); the rocket next to it lifts
// off once the request is sent.
import { Icon } from "astro-icon/components";
import { actions } from "astro:actions";
import trans from "@i18n";
import { EMAIL, mailtoHref } from "@lib/contact";

const lang = Astro.locals.lang;
const t = trans.home;
const c = trans.contact;
const types = [
    { value: "site", label: c.typesite[lang] },
    { value: "app", label: c.typeapp[lang] },
    { value: "soft", label: c.typesoft[lang] },
    { value: "unsure", label: c.typeunsure[lang] },
];
// Without JavaScript the form posts to the page itself, and the action's
// result comes back with it: the page then opens on the outcome
const result = Astro.getActionResult(actions.sendQuote);
const sent = result && !result.error ? result.data : undefined;
const failed = result?.error ? c.errsend : undefined;
// The messages that name an address get it as a link
const split = (message: string) => message.split("{email}") as [string, string];
const [doneBefore, doneAfter] = split(c.donetext[lang]);
---

<section class="launch" id="devis" aria-labelledby="launch-title">
    <canvas class="launch-canvas" data-launch-canvas aria-hidden="true"></canvas>
    <div class="wrap launch-inner">
        <div class="launch-head reveal">
            <p class="eyebrow caption-3">{t.launcheyebrow[lang]}</p>
            <h2 id="launch-title" class="heading-2 grad">{t.launchtitle[lang]}</h2>
            <p class="body-7 text-muted">{t.launchintro[lang]}</p>
        </div>

        <div class="launch-row">
            <div class="card form-card reveal" style="--d:120ms">
                <form class="form" id="devis-form" method="post" action={actions.sendQuote} novalidate aria-describedby="form-status" hidden={!!sent}>
                    <input type="hidden" name="lang" value={lang} />
                    <!-- Honeypot: out of sight and out of reach for people, filled in by bots -->
                    <div class="trap" aria-hidden="true">
                        <label for="website">Website</label>
                        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
                    </div>
                    <fieldset class="field" aria-describedby="err-type">
                        <legend class="label title-4">{c.legend[lang]} <span class="opt">{c.several[lang]}</span></legend>
                        <div class="choices" id="type-group">
                            {types.map(type => (
                                <label class="choice">
                                    <input type="checkbox" name="type" value={type.value} id={`type-${type.value}`} />
                                    <span class="body-5"><Icon name="check" class="size-4" />{type.label}</span>
                                </label>
                            ))}
                        </div>
                        <p class="error caption-1" id="err-type"></p>
                    </fieldset>
                    <div class="field">
                        <label class="label title-4" for="idea">{c.idealabel[lang]}</label>
                        <p class="hint caption-2" id="hint-idea">{c.ideahint[lang]}</p>
                        <textarea class="input" id="idea" name="idea" rows="4" aria-describedby="hint-idea err-idea" placeholder={c.ideaplaceholder[lang]}></textarea>
                        <p class="error caption-1" id="err-idea"></p>
                    </div>
                    <div class="field">
                        <label class="label title-4" for="email">{c.emaillabel[lang]}</label>
                        <input class="input" type="email" id="email" name="email" autocomplete="email" spellcheck="false" aria-describedby="err-email" placeholder={c.emailplaceholder[lang]} />
                        <p class="error caption-1" id="err-email"></p>
                    </div>
                    <div class="field-row">
                        <div class="field">
                            <label class="label title-4" for="deadline">{c.deadlinelabel[lang]} <span class="opt">{c.optional[lang]}</span></label>
                            <input class="input" type="text" id="deadline" name="deadline" autocomplete="off" placeholder={c.deadlineplaceholder[lang]} />
                        </div>
                        <div class="field">
                            <label class="label title-4" for="budget">{c.budgetlabel[lang]} <span class="opt">{c.optional[lang]}</span></label>
                            <input class="input" type="text" id="budget" name="budget" autocomplete="off" placeholder={c.budgetplaceholder[lang]} />
                        </div>
                    </div>
                    <div class="form-foot">
                        <button class="btn btn-primary button-md" type="submit" id="send-btn" data-sending={c.sending[lang]}><span>{c.submit[lang]}</span> <Icon name="arrow-right" class="size-5" /></button>
                        <p class="sr-only" id="form-status" role="status" aria-live="polite"></p>
                        <p class="send-error caption-1" id="send-error" role="alert" hidden={!failed}>
                            {failed && <>{split(failed[lang])[0]}<a class="mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>{split(failed[lang])[1]}</>}
                        </p>
                        <p class="caption-2 text-muted">{c.howitworks[lang]}</p>
                    </div>
                </form>

                <div class="form-done" id="form-done" hidden={!sent}>
                    <span class="seal" aria-hidden="true"><Icon name="check-circle" class="size-6" /></span>
                    <h3 class="heading-5" id="done-title" tabindex="-1">{c.donetitle[lang]}</h3>
                    <p class="body-3">{doneBefore}<strong class="done-email" id="done-email">{sent?.email}</strong>{doneAfter}</p>
                    <a class="btn btn-ghost btn-sm button-sm" id="another-btn" href="#devis">{c.another[lang]}</a>
                </div>
            </div>

            <!-- Decorative: the rocket of the canvas stands on this pad, the
                 lights mirror the required fields -->
            <div class="pad" id="pad" aria-hidden="true">
                <svg class="pad-art" viewBox="0 0 220 360">
                    <path class="pad-ground" d="M0 334 H220"></path>
                    <path class="pad-tower" d="M14 334 V60 M40 334 V60 M10 60 H44 M27 60 V36 M14 334 L40 307 L14 280 L40 253 L14 226 L40 199 L14 172 L40 145 L14 118 L40 91 L14 64"></path>
                    <circle class="pad-beacon" cx="27" cy="32" r="3"></circle>
                    <g class="pad-arm"><path d="M40 136 H99 M40 148 L99 136 M99 130 V142"></path></g>
                    <path class="pad-deck" d="M70 300 H114 V310 H70 Z M166 300 H210 V310 H166 Z M80 310 V334 M104 310 V334 M176 310 V334 M200 310 V334 M114 300 L124 334 M166 300 L156 334"></path>
                </svg>
                <ul class="pad-checks caption-5">
                    <li data-check="type">{c.padproject[lang]}</li>
                    <li data-check="idea">{c.padidea[lang]}</li>
                    <li data-check="email">{c.pademail[lang]}</li>
                </ul>
            </div>
        </div>

        <p class="direct caption-2 reveal">
            <span class="text-muted">{c.direct[lang]}</span>
            <a class="mail" id="mail-direct" href={mailtoHref(lang)}>{EMAIL}</a>
            <button type="button" class="icon-btn" data-copy="mail-direct" data-status="copy-direct" data-copied={trans.common.copied[lang]} data-failed={trans.common.copyfailed[lang]} aria-label={trans.common.copyaddress[lang]}><Icon name="copy" class="size-4" /></button>
            <span class="copy-status caption-3" id="copy-direct" role="status" aria-live="polite"></span>
        </p>
    </div>
    <div class="launch-space" aria-hidden="true"></div>
</section>

<style>
    .launch {
        position: relative;
        z-index: 1;
        overflow: hidden;
        padding-top: 64px;
    }

    @media (min-width: 1024px) {
        .launch { padding-top: 96px; }
    }

    /* A full height strip centred on the pad (placed by the script): the rocket
       fades out at the top when it leaves, the ground cloud at the sides */
    .launch-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        -webkit-mask-image: linear-gradient(to bottom, transparent, #000 220px), linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
        -webkit-mask-composite: source-in;
        mask-image: linear-gradient(to bottom, transparent, #000 220px), linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
        mask-composite: intersect;
    }

    .launch-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
    }

    .launch-head {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        text-align: center;
        max-width: 680px;
    }

    .launch-row {
        position: relative;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
    }

    .launch-space {
        height: 64px;
    }

    .form-card {
        width: 100%;
        max-width: 720px;
        padding: 24px;
        background: rgb(8 15 33 / 0.92);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
    }

    @media (min-width: 1024px) {
        .form-card { padding: 32px; }
    }

    .form {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
        border: 0;
        margin: 0;
        padding: 0;
        min-width: 0;
    }

    .label {
        color: var(--heading);
        padding: 0;
    }

    /* A fieldset's legend is laid out outside its flex container, so the
       field's gap does not reach it: the same 8px is given as a margin. */
    legend.label {
        margin-bottom: 8px;
    }

    .opt {
        color: var(--muted);
        font-weight: 400;
    }

    .hint {
        color: var(--muted);
    }

    .input {
        width: 100%;
        min-width: 0;
        background: var(--fill);
        color: var(--heading);
        border: 1px solid var(--line-strong);
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 1rem;
        line-height: 1.5rem;
        transition: border-color 300ms var(--ease-space), background-color 300ms var(--ease-space);
    }

    .input::placeholder {
        color: var(--muted);
        opacity: 1;
    }

    .input:hover {
        border-color: var(--line-hover);
    }

    .input:focus-visible {
        outline: 2px solid var(--accent-text);
        outline-offset: 0;
        border-color: var(--accent-text);
    }

    textarea.input {
        min-height: 120px;
        resize: vertical;
    }

    .input[aria-invalid="true"] {
        border-color: var(--color-danger);
    }

    .field-row {
        display: grid;
        gap: 24px;
        grid-template-columns: minmax(0, 1fr);
    }

    @media (min-width: 640px) {
        .field-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    .error {
        color: var(--color-danger);
    }

    .error:empty {
        display: none;
    }

    .choices {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .choice {
        position: relative;
    }

    .choice input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        opacity: 0;
        cursor: pointer;
    }

    .choice span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 9999px;
        border: 1px solid var(--line-strong);
        background: var(--fill);
        color: var(--text);
        transition: border-color 300ms var(--ease-space), background-color 300ms var(--ease-space), color 300ms var(--ease-space), transform 300ms var(--ease-space);
    }

    .choice span :global(svg) { display: none; }
    .choice:hover span { border-color: var(--line-hover); color: var(--heading); }
    .choice input:active + span { transform: scale(0.98); }
    .choice input:checked + span { border-color: var(--accent-text); color: var(--heading); background: var(--accent-soft); }
    .choice input:checked + span :global(svg) { display: block; color: var(--accent-text); }
    .choice input:focus-visible + span { outline: 2px solid var(--accent-text); outline-offset: 2px; }
    .choices[aria-invalid="true"] .choice span { border-color: var(--color-danger); }

    .form-foot {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .form-foot .btn {
        width: 100%;
    }

    @media (min-width: 640px) {
        .form-foot .btn {
            width: auto;
            align-self: flex-start;
        }
    }

    .form-done {
        display: flex;
        flex-direction: column;
        gap: 16px;
        align-items: flex-start;
    }

    .form-done h3:focus {
        outline: none;
    }

    .seal {
        width: 48px;
        height: 48px;
        border-radius: 9999px;
        display: grid;
        place-items: center;
        background: rgb(95 211 148 / 0.12);
        color: var(--color-pass);
        border: 1px solid rgb(95 211 148 / 0.4);
        flex-shrink: 0;
    }

    .done-email {
        color: var(--heading);
        font-weight: 600;
        word-break: break-all;
    }

    .send-error {
        color: var(--color-danger);
    }

    .send-error .mail {
        color: inherit;
        text-decoration: underline;
    }

    /* The honeypot: rendered (some bots skip hidden fields) but off-screen */
    .trap {
        position: absolute;
        left: -10000px;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }

    .direct {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 8px 12px;
        text-align: center;
    }

    .mail {
        color: var(--heading);
        font-family: var(--font-mono);
        font-weight: 500;
        user-select: all;
        word-break: break-all;
        border-radius: 6px;
    }

    .mail:hover {
        color: var(--accent-text);
    }

    .copy-status {
        color: var(--color-pass);
    }

    /* Launch pad, drawn like the star chart. Its geometry (viewBox 220 x 360) is
       mirrored in lib/space/rocket.ts: rocket axis at x = 140, deck at y = 300,
       umbilical arm pivoting at (40, 142). */
    .pad {
        position: relative;
        width: 180px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    @media (min-width: 1280px) {
        .pad {
            position: absolute;
            left: calc(50% + 360px + 16px);
            bottom: 0;
            width: 210px;
        }
    }

    .pad-art {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .pad-ground { stroke: var(--line-strong); stroke-width: 1; }
    .pad-tower, .pad-arm path { stroke: rgb(150 180 255 / 0.5); stroke-width: 1.2; }
    .pad-deck { stroke: rgb(150 180 255 / 0.75); stroke-width: 1.4; fill: rgb(8 15 33 / 0.7); transition: stroke 600ms var(--ease-space); }
    .pad:global(.firing) .pad-deck { stroke: #FFC98A; }
    .pad-arm { transform-box: view-box; transform-origin: 40px 142px; transition: transform 900ms var(--ease-space); }
    .pad:global(.launched) .pad-arm { transform: rotate(-58deg); }
    .pad-beacon { fill: #FFC08A; stroke: none; animation: beacon 1600ms var(--ease-space) infinite alternate; }

    @keyframes beacon {
        from { opacity: 0.25; }
        to { opacity: 1; }
    }

    .pad-checks {
        display: flex;
        gap: 8px;
        color: var(--muted);
        font-family: var(--font-mono);
    }

    .pad-checks li {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: color 300ms var(--ease-space);
    }

    .pad-checks li::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 9999px;
        background: var(--line-strong);
        transition: background-color 300ms var(--ease-space), box-shadow 300ms var(--ease-space);
    }

    .pad-checks li:global(.on) { color: var(--heading); }

    .pad-checks li:global(.on)::before {
        background: var(--color-pass);
        box-shadow: 0 0 6px var(--color-pass);
    }
</style>

<script>
    import { actions } from "astro:actions";
    import { contact } from "@i18n/translations/contact";
    import { EMAIL } from "@lib/contact";
    import { mountCopyButtons } from "@lib/copy";
    import { EMAIL_PATTERN, IDEA_MIN } from "@lib/quote";
    import { mountLaunchPad } from "@lib/space/rocket";

    const lang = (document.documentElement.lang === "en" ? "en" : "fr") as App.LangCode;
    const form = document.getElementById("devis-form") as HTMLFormElement | null;
    const done = document.getElementById("form-done");
    const status = document.getElementById("form-status");
    const sendError = document.getElementById("send-error");
    const sendBtn = document.getElementById("send-btn") as HTMLButtonElement | null;
    const idea = document.getElementById("idea") as HTMLTextAreaElement | null;
    const email = document.getElementById("email") as HTMLInputElement | null;
    const section = document.getElementById("devis");
    const canvas = document.querySelector<HTMLCanvasElement>("[data-launch-canvas]");
    const padEl = document.getElementById("pad");
    const pad = section && canvas && padEl ? mountLaunchPad(section, canvas, padEl) : null;
    let attempted = false;
    let sending = false;

    const typeBoxes = () => [...(form?.querySelectorAll<HTMLInputElement>('input[name="type"]') ?? [])];
    const checkedTypes = () => typeBoxes().filter(box => box.checked);

    // Several types can be asked at once, but "not sure yet" excludes the
    // actual types: checking one side unchecks the other.
    function keepTypesConsistent(changed: HTMLInputElement): void {
        if (!changed.checked) return;
        const unsure = changed.value === "unsure";
        for (const box of typeBoxes()) {
            if ((box.value === "unsure") !== unsure) box.checked = false;
        }
    }

    // Each required field returns its error message, or "" when it is valid.
    // The same rules (lib/quote.ts) are checked again by the server.
    const fields: Record<"type" | "idea" | "email", () => string> = {
        type: () => (checkedTypes().length > 0 ? "" : contact.errtype[lang]),
        idea: () => {
            const value = idea?.value.trim() ?? "";
            if (!value) return contact.erridea[lang];
            if (value.length < IDEA_MIN) return contact.errideashort[lang];
            return "";
        },
        email: () => {
            const value = email?.value.trim() ?? "";
            if (!value) return contact.erremail[lang];
            if (!EMAIL_PATTERN.test(value)) return contact.erremailformat[lang];
            return "";
        },
    };
    type Field = keyof typeof fields;
    const isField = (name: string): name is Field => name in fields;
    // The control that carries a field's error state and receives the focus
    const controlOf = (name: Field): HTMLElement | null =>
        name === "type" ? typeBoxes()[0] ?? null : name === "idea" ? idea : email;

    function showError(name: Field): string {
        const message = fields[name]();
        const error = document.getElementById(`err-${name}`);
        if (error) error.textContent = message;
        const target = name === "type" ? document.getElementById("type-group") : controlOf(name);
        if (message) target?.setAttribute("aria-invalid", "true");
        else target?.removeAttribute("aria-invalid");
        if (name === "type") {
            typeBoxes().forEach(box => {
                if (message) box.setAttribute("aria-invalid", "true");
                else box.removeAttribute("aria-invalid");
            });
        }
        return message;
    }

    // The pad lights mirror the required fields, silently (errors only show
    // after a first attempt)
    function syncChecks(): void {
        let all = true;
        document.querySelectorAll<HTMLElement>(".pad-checks [data-check]").forEach(light => {
            const name = light.dataset.check ?? "";
            const ok = isField(name) && !fields[name]();
            light.classList.toggle("on", ok);
            if (!ok) all = false;
        });
        pad?.setReady(all);
    }

    // A failed send names the address to write to instead, as a link
    function showSendError(message?: string): void {
        if (!sendError) return;
        sendError.replaceChildren();
        sendError.hidden = !message;
        if (!message) return;
        const [before, after] = message.split("{email}");
        const link = Object.assign(document.createElement("a"), { className: "mail", href: `mailto:${EMAIL}`, textContent: EMAIL });
        sendError.append(before, link, after ?? "");
    }

    function setSending(on: boolean): void {
        sending = on;
        if (!sendBtn) return;
        sendBtn.disabled = on;
        sendBtn.setAttribute("aria-busy", String(on));
        const label = sendBtn.querySelector("span");
        if (label) {
            label.dataset.idle ??= label.textContent ?? "";
            label.textContent = on ? sendBtn.dataset.sending ?? "" : label.dataset.idle;
        }
        if (status) status.textContent = on ? sendBtn.dataset.sending ?? "" : "";
    }

    form?.addEventListener("change", event => {
        const target = event.target as HTMLInputElement;
        if (target.name === "type") keepTypesConsistent(target);
    });
    form?.addEventListener("input", syncChecks);
    form?.addEventListener("change", syncChecks);
    // Once a field shows an error (after a first attempt, or on leaving it),
    // it is checked again as it is typed, so the message goes as soon as it is fixed
    form?.addEventListener("input", event => {
        const name = (event.target as HTMLInputElement).name;
        if (isField(name) && (attempted || document.getElementById(`err-${name}`)?.textContent)) showError(name);
    });
    // A typed text is checked when leaving it, an empty one only on submit
    form?.addEventListener("focusout", event => {
        const target = event.target as HTMLInputElement;
        if ((target.name === "idea" || target.name === "email") && target.value.trim()) showError(target.name);
    });

    form?.addEventListener("submit", async event => {
        // Sent by the script; without it, the browser posts the form to the
        // page and the action answers with it (see the frontmatter)
        event.preventDefault();
        if (sending) return;
        attempted = true;
        showSendError();
        const invalid = (Object.keys(fields) as Field[]).filter(name => showError(name));
        if (invalid.length > 0) {
            if (status) status.textContent = invalid.length === 1 ? contact.errone[lang] : contact.errmany[lang].replace("{count}", `${invalid.length}`);
            controlOf(invalid[0])?.focus();
            return;
        }

        setSending(true);
        let result: Awaited<ReturnType<typeof actions.sendQuote>> | undefined;
        try {
            result = await actions.sendQuote(new FormData(form));
        } catch {
            // Offline, or the server could not be reached at all
        }
        setSending(false);
        if (!result?.data) {
            showSendError(contact.errsend[lang]);
            return;
        }

        const doneEmail = document.getElementById("done-email");
        if (doneEmail) doneEmail.textContent = result.data.email;
        form.hidden = true;
        if (done) done.hidden = false;
        pad?.launch();
        document.getElementById("done-title")?.focus();
    });

    // Back to an empty form (and the rocket back on its pad)
    document.getElementById("another-btn")?.addEventListener("click", event => {
        event.preventDefault();
        form?.reset();
        attempted = false;
        (Object.keys(fields) as Field[]).forEach(name => {
            const error = document.getElementById(`err-${name}`);
            if (error) error.textContent = "";
            controlOf(name)?.removeAttribute("aria-invalid");
        });
        document.getElementById("type-group")?.removeAttribute("aria-invalid");
        typeBoxes().forEach(box => box.removeAttribute("aria-invalid"));
        showSendError();
        syncChecks();
        if (done) done.hidden = true;
        if (form) form.hidden = false;
        pad?.reset();
        typeBoxes()[0]?.focus();
    });

    // "Get a free quote" in a pricing plan checks the matching project type,
    // on top of the ones already chosen
    document.querySelectorAll<HTMLAnchorElement>("[data-preset]").forEach(link => {
        link.addEventListener("click", () => {
            const box = document.getElementById(`type-${link.dataset.preset}`) as HTMLInputElement | null;
            if (!box) return;
            box.checked = true;
            keepTypesConsistent(box);
            syncChecks();
            if (attempted) showError("type");
        });
    });

    mountCopyButtons();
</script>
