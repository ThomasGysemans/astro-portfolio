---
import type { Project } from "@data/models";
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { categoryIcon } from "@data/categories";
import ProjectThumb from "@components/ProjectThumb.astro";
import { GITHUB_URL, LINKEDIN_URL, MALT_URL } from "@lib/contact";
import { yearsOfCode } from "@lib/profile";
import trans from "@i18n";

interface Props {
    project?: Project; // the astronomy project shown next to the text
    total: number; // number of public projects
}

const { project, total } = Astro.props;
const lang = Astro.locals.lang;
const t = trans.home;
const newWindow = ` (${trans.common.newwindow[lang]})`;
// The portrait, pre-cropped around the face in three sizes and three formats
// (public/images): the browser picks the lightest one its screen needs
const PORTRAIT = [144, 288, 432];
const portraitSet = (ext: string) => PORTRAIT.map(w => `/images/moi-${w}.${ext} ${w}w`).join(", ");
const PORTRAIT_SIZES = "(min-width: 1024px) 144px, 128px";
const links = [
    { href: GITHUB_URL, label: "GitHub", icon: "github" },
    { href: LINKEDIN_URL, label: "LinkedIn", icon: "linkedin" },
    { href: MALT_URL, label: trans.common.malt[lang], icon: "arrow-up-right" },
];
---

<section class="section" id="apropos" aria-labelledby="about-title">
    <div class="wrap about-grid">
        <div class="about-copy reveal">
            <!-- "Head in the stars": an orbit ring around the portrait, its far
                 half behind the photo, its near half over it, a small moon on it -->
            <div class="portrait">
                <svg class="portrait-orbit back" viewBox="0 0 212 60" aria-hidden="true"><g transform="rotate(-10 106 30)"><path pathLength="1" d="M 2 30 A 104 22 0 0 1 210 30"></path></g></svg>
                <picture>
                    <source type="image/avif" srcset={portraitSet("avif")} sizes={PORTRAIT_SIZES} />
                    <source type="image/webp" srcset={portraitSet("webp")} sizes={PORTRAIT_SIZES} />
                    <img src="/images/moi-288.jpg" srcset={portraitSet("jpg")} sizes={PORTRAIT_SIZES} width="144" height="144" alt={t.portraitalt[lang]} loading="lazy" decoding="async" />
                </picture>
                <svg class="portrait-orbit front" viewBox="0 0 212 60" aria-hidden="true"><g transform="rotate(-10 106 30)"><path pathLength="1" d="M 210 30 A 104 22 0 0 1 2 30"></path><circle class="moon" cx="197.8" cy="40.3" r="4"></circle></g></svg>
            </div>
            <p class="eyebrow caption-3">{t.abouteyebrow[lang]}</p>
            <h2 id="about-title" class="heading-2">{t.abouttitle[lang]}</h2>
            <p class="body-7">{t.about1[lang]}</p>
            <p class="body-3">{t.about2[lang]}</p>
            <dl class="stats">
                <div class="stat"><dt class="caption-2 text-muted">{t.statyears[lang]}</dt><dd class="heading-4 font-mono">{yearsOfCode()}</dd></div>
                {total > 0 && <div class="stat"><dt class="caption-2 text-muted">{t.statprojects[lang]}</dt><dd class="heading-4 font-mono">{total}</dd></div>}
            </dl>
            <div class="about-links">
                {links.map(link => (
                    <a class="btn btn-ghost btn-sm button-sm" href={link.href} target="_blank" rel="noopener"><Icon name={link.icon} class="size-4" />{link.label}<span class="sr-only">{newWindow}</span></a>
                ))}
            </div>
        </div>

        {project && (
            <article class="card astro-card reveal">
                <ProjectThumb
                    thumb={project.thumb}
                    large={project.thumbLarge}
                    sizes="(min-width: 1280px) 645px, (min-width: 1024px) 50vw, calc(100vw - 50px)"
                    video={project.thumbVideo}
                    alt={project.caption[lang] || project.name[lang]}
                    class="astro-shot"
                />
                <div class="astro-body">
                    <p class="work-meta caption-3">
                        <span><Icon name={categoryIcon(project.categories[0])} class="size-4" />{project.sub[lang]}</span>
                        <span class="font-mono text-muted caption-5">{project.date}</span>
                    </p>
                    <h3 class="heading-6"><a class="stretched" href={getRelativeLocaleUrl(lang, `/projects/${project.slug}`)}>{project.name[lang]}</a></h3>
                    <p class="body-6">{project.description[lang]}</p>
                    {project.link && (
                        <p class="caption-1 links">
                            <a class="text-link" href={project.link} target="_blank" rel="noopener">{t.play[lang]}<span class="sr-only"> {project.name[lang]}{newWindow}</span> <Icon name="arrow-up-right" class="size-4" /></a>
                        </p>
                    )}
                </div>
            </article>
        )}
    </div>
</section>

<style>
    .about-grid {
        display: grid;
        gap: 48px;
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
    }

    @media (min-width: 1024px) {
        .about-grid {
            grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
            gap: 64px;
        }

        .about-copy {
            position: sticky;
            top: 112px;
        }
    }

    .about-copy {
        display: flex;
        flex-direction: column;
        gap: 24px;
        align-items: flex-start;
    }

    /* The portrait: 128px (144px from 1024px). The ring reaches past it on
       both sides, but never past the page gutter on the left. */
    .portrait {
        position: relative;
        isolation: isolate;
        width: 128px;
        height: 128px;
        margin-bottom: 8px;
        flex-shrink: 0;
    }

    .portrait img {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 9999px;
        border: 1px solid var(--line-strong);
        object-fit: cover;
    }

    .portrait-orbit {
        position: absolute;
        left: -9%;
        top: 49%;
        width: 147%;
        height: 42%;
        overflow: visible;
        pointer-events: none;
    }

    .portrait-orbit.back { z-index: 0; }
    .portrait-orbit.front { z-index: 2; }

    .portrait-orbit path {
        fill: none;
        stroke: var(--chart-light);
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 1400ms var(--ease-space) 300ms;
    }

    .portrait-orbit.back path { opacity: 0.35; }
    .portrait-orbit.front path { opacity: 0.9; transition-delay: 700ms; }

    .portrait-orbit .moon {
        fill: var(--heading);
        filter: drop-shadow(0 0 4px rgb(141 180 255 / 0.9));
        transition: opacity 600ms var(--ease-space) 1600ms;
    }

    /* Drawn when the section comes into view */
    :global(.reveal.pending) .portrait-orbit path { stroke-dashoffset: 1; }
    :global(.reveal.pending) .portrait-orbit .moon { opacity: 0; }

    :global(:root[data-motion="reduce"]) .portrait-orbit path,
    :global(:root[data-motion="reduce"]) .portrait-orbit .moon {
        transition: none;
    }

    @media (min-width: 1024px) {
        .portrait {
            width: 144px;
            height: 144px;
        }
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        padding-block: 16px;
        width: 100%;
        max-width: 360px;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stat dd {
        order: -1;
    }

    .about-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .astro-card {
        position: relative;
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
        transition: border-color 300ms var(--ease-space), transform 500ms var(--ease-space), opacity 700ms var(--ease-space);
    }

    .astro-card:hover {
        border-color: var(--line-strong);
        transform: translateY(-4px);
    }

    .astro-card:has(.stretched:focus-visible) {
        outline: 2px solid var(--accent-text);
        outline-offset: 2px;
    }

    .astro-card :global(.astro-shot) {
        border-radius: 16px;
        border: 1px solid var(--line);
    }

    .astro-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
    }

    .work-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: var(--accent-text);
    }

    .work-meta span:first-child {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .links a {
        position: relative;
        z-index: 1;
    }

    :global(:root[data-motion="reduce"]) .astro-card:hover {
        transform: none;
    }
</style>
