---
import type { Project, Review } from "@data/models";
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { GITHUB_URL, LINKEDIN_URL, MALT_URL } from "@lib/contact";
import { averageRating, yearsOfCode } from "@lib/profile";
import { inlineLinks } from "@lib/inline-links";
import trans from "@i18n";

interface Props {
    projects: Project[]; // the public projects: counted, and linked from the text
    reviews: Review[]; // the clients' reviews, for their average rating
}

const { projects, reviews } = Astro.props;
const lang = Astro.locals.lang;
const t = trans.home;
const newWindow = ` (${trans.common.newwindow[lang]})`;
// The portrait, pre-cropped around the face in three sizes and three formats
// (public/images): the browser picks the lightest one its screen needs
const PORTRAIT = [144, 288, 432];
const portraitSet = (ext: string) => PORTRAIT.map(w => `/images/moi-${w}.${ext} ${w}w`).join(", ");
const PORTRAIT_SIZES = "(min-width: 1024px) 144px, 128px";
// The projects the second paragraph names link to their pages while public
// The clients' average mark, written the local way ("4,7" in French)
const rating = averageRating(reviews.map(r => r.rating));
const ratingText = rating === undefined ? "" : new Intl.NumberFormat(lang, { maximumFractionDigits: 1 }).format(rating);
const ratingLabel = reviews.length === 1 ? t.statratingone[lang] : t.statratingmany[lang].replace("{count}", `${reviews.length}`);
const about2 = inlineLinks(t.about2[lang], slug =>
    projects.some(p => p.slug === slug) ? getRelativeLocaleUrl(lang, `/projects/${slug}`) : undefined);
const links = [
    { href: GITHUB_URL, label: "GitHub", icon: "github" },
    { href: LINKEDIN_URL, label: "LinkedIn", icon: "linkedin" },
    { href: MALT_URL, label: trans.common.malt[lang], icon: "arrow-up-right" },
];
---

<section class="section" id="apropos" aria-labelledby="about-title">
    <div class="wrap">
        <div class="about-copy reveal">
            <!-- "Head in the stars": an orbit ring around the portrait, its far
                 half behind the photo, its near half over it, a small moon on it -->
            <div class="portrait">
                <svg class="portrait-orbit back" viewBox="0 0 212 60" aria-hidden="true"><g transform="rotate(-10 106 30)"><path pathLength="1" d="M 2 30 A 104 22 0 0 1 210 30"></path></g></svg>
                <picture>
                    <source type="image/avif" srcset={portraitSet("avif")} sizes={PORTRAIT_SIZES} />
                    <source type="image/webp" srcset={portraitSet("webp")} sizes={PORTRAIT_SIZES} />
                    <img src="/images/moi-288.jpg" srcset={portraitSet("jpg")} sizes={PORTRAIT_SIZES} width="144" height="144" alt={t.portraitalt[lang]} loading="lazy" decoding="async" />
                </picture>
                <svg class="portrait-orbit front" viewBox="0 0 212 60" aria-hidden="true"><g transform="rotate(-10 106 30)"><path pathLength="1" d="M 210 30 A 104 22 0 0 1 2 30"></path><circle class="moon" cx="197.8" cy="40.3" r="4"></circle></g></svg>
            </div>
            <p class="eyebrow caption-3">{t.abouteyebrow[lang]}</p>
            <h2 id="about-title" class="heading-2">{t.abouttitle[lang]}</h2>
            <p class="body-7">{t.about1[lang]}</p>
            <p class="body-3">{about2.map(run => run.href ? <a class="inline-link" href={run.href}>{run.text}</a> : run.text)}</p>
            <dl class="stats">
                <div class="stat"><dt class="caption-2 text-muted">{t.statyears[lang]}</dt><dd class="heading-4 font-mono">{yearsOfCode()}</dd></div>
                {projects.length > 0 && <div class="stat"><dt class="caption-2 text-muted">{t.statprojects[lang]}</dt><dd class="heading-4 font-mono">{projects.length}</dd></div>}
                {rating !== undefined && (
                    <div class="stat">
                        <dt class="caption-2 text-muted">{ratingLabel}</dt>
                        <dd class="heading-4 font-mono"><span aria-hidden="true">{ratingText}<span class="out-of">/5</span></span><span class="sr-only">{t.statrating[lang].replace("{n}", ratingText)}</span></dd>
                    </div>
                )}
            </dl>
            <div class="about-links">
                {links.map(link => (
                    <a class="btn btn-ghost btn-sm button-sm" href={link.href} target="_blank" rel="noopener"><Icon name={link.icon} class="size-4" />{link.label}<span class="sr-only">{newWindow}</span></a>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    /* One column of copy. From 1024px it keeps to the left and leaves the
       right of the section to Saturn (placed in Homepage.astro). */
    .about-copy {
        display: flex;
        flex-direction: column;
        gap: 24px;
        align-items: flex-start;
    }

    .about-copy h2 { text-wrap: balance; }
    .about-copy p { max-width: 640px; }

    @media (min-width: 1024px) {
        .about-copy { max-width: 560px; }
    }

    /* A link inside running text: underlined, so it does not rely on its
       colour alone (RGAA 10.6) */
    .inline-link {
        color: var(--accent-text);
        text-decoration: underline;
        text-decoration-color: var(--accent-line);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        border-radius: 6px;
        transition: color 300ms var(--ease-space), text-decoration-color 300ms var(--ease-space);
    }

    .inline-link:hover {
        color: var(--accent-text-hover);
        text-decoration-color: currentColor;
    }

    /* The portrait: 128px (144px from 1024px). The ring reaches past it on
       both sides, but never past the page gutter on the left. */
    .portrait {
        position: relative;
        isolation: isolate;
        width: 128px;
        height: 128px;
        margin-bottom: 8px;
        flex-shrink: 0;
    }

    .portrait img {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 9999px;
        border: 1px solid var(--line-strong);
        object-fit: cover;
    }

    .portrait-orbit {
        position: absolute;
        left: -9%;
        top: 49%;
        width: 147%;
        height: 42%;
        overflow: visible;
        pointer-events: none;
    }

    .portrait-orbit.back { z-index: 0; }
    .portrait-orbit.front { z-index: 2; }

    .portrait-orbit path {
        fill: none;
        stroke: var(--chart-light);
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 1400ms var(--ease-space) 300ms;
    }

    .portrait-orbit.back path { opacity: 0.35; }
    .portrait-orbit.front path { opacity: 0.9; transition-delay: 700ms; }

    .portrait-orbit .moon {
        fill: var(--heading);
        filter: drop-shadow(0 0 4px rgb(141 180 255 / 0.9));
        transition: opacity 600ms var(--ease-space) 1600ms;
    }

    /* Drawn when the section comes into view */
    :global(.reveal.pending) .portrait-orbit path { stroke-dashoffset: 1; }
    :global(.reveal.pending) .portrait-orbit .moon { opacity: 0; }

    :global(:root[data-motion="reduce"]) .portrait-orbit path,
    :global(:root[data-motion="reduce"]) .portrait-orbit .moon {
        transition: none;
    }

    @media (min-width: 1024px) {
        .portrait {
            width: 144px;
            height: 144px;
        }
    }

    /* As many equal columns as there are stats (the project count and the
       rating are left out when PocketBase has nothing to give) */
    .stats {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(0, 1fr);
        gap: 16px;
        padding-block: 16px;
        width: 100%;
        max-width: 520px;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stat dd {
        order: -1;
    }

    /* The smaller "/5" must not make its line taller than the plain numbers */
    .stat .out-of {
        color: var(--muted);
        font-size: 0.6em;
        line-height: 0;
    }

    .about-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
</style>
