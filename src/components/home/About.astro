---
import type { Project } from "@data/models";
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { categoryIcon } from "@data/categories";
import ProjectThumb from "@components/ProjectThumb.astro";
import { GITHUB_URL, LINKEDIN_URL, MALT_URL } from "@lib/contact";
import { yearsOfCode } from "@lib/profile";
import trans from "@i18n";

interface Props {
    project?: Project; // the astronomy project shown next to the text
    total: number; // number of public projects
}

const { project, total } = Astro.props;
const lang = Astro.locals.lang;
const t = trans.home;
const newWindow = ` (${trans.common.newwindow[lang]})`;
const links = [
    { href: GITHUB_URL, label: "GitHub", icon: "github" },
    { href: LINKEDIN_URL, label: "LinkedIn", icon: "linkedin" },
    { href: MALT_URL, label: trans.common.malt[lang], icon: "arrow-up-right" },
];
---

<section class="section" id="apropos" aria-labelledby="about-title">
    <div class="wrap about-grid">
        <div class="about-copy reveal">
            <p class="eyebrow caption-3">{t.abouteyebrow[lang]}</p>
            <h2 id="about-title" class="heading-2">{t.abouttitle[lang]}</h2>
            <p class="body-7">{t.about1[lang]}</p>
            <p class="body-3">{t.about2[lang]}</p>
            <dl class="stats">
                <div class="stat"><dt class="caption-2 text-muted">{t.statyears[lang]}</dt><dd class="heading-4 font-mono">{yearsOfCode()}</dd></div>
                {total > 0 && <div class="stat"><dt class="caption-2 text-muted">{t.statprojects[lang]}</dt><dd class="heading-4 font-mono">{total}</dd></div>}
            </dl>
            <div class="about-links">
                {links.map(link => (
                    <a class="btn btn-ghost btn-sm button-sm" href={link.href} target="_blank" rel="noopener"><Icon name={link.icon} class="size-4" />{link.label}<span class="sr-only">{newWindow}</span></a>
                ))}
            </div>
        </div>

        {project && (
            <article class="card astro-card reveal">
                <ProjectThumb
                    thumb={project.thumb}
                    large={project.thumbLarge}
                    sizes="(min-width: 1280px) 645px, (min-width: 1024px) 50vw, calc(100vw - 50px)"
                    video={project.thumbVideo}
                    alt={project.caption[lang] || project.name[lang]}
                    class="astro-shot"
                />
                <div class="astro-body">
                    <p class="work-meta caption-3">
                        <span><Icon name={categoryIcon(project.categories[0])} class="size-4" />{project.sub[lang]}</span>
                        <span class="font-mono text-muted caption-5">{project.date}</span>
                    </p>
                    <h3 class="heading-6"><a class="stretched" href={getRelativeLocaleUrl(lang, `/projects/${project.slug}`)}>{project.name[lang]}</a></h3>
                    <p class="body-6">{project.description[lang]}</p>
                    {project.link && (
                        <p class="caption-1 links">
                            <a class="text-link" href={project.link} target="_blank" rel="noopener">{t.play[lang]}<span class="sr-only"> {project.name[lang]}{newWindow}</span> <Icon name="arrow-up-right" class="size-4" /></a>
                        </p>
                    )}
                </div>
            </article>
        )}
    </div>
</section>

<style>
    .about-grid {
        display: grid;
        gap: 48px;
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
    }

    @media (min-width: 1024px) {
        .about-grid {
            grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
            gap: 64px;
        }

        .about-copy {
            position: sticky;
            top: 112px;
        }
    }

    .about-copy {
        display: flex;
        flex-direction: column;
        gap: 24px;
        align-items: flex-start;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        padding-block: 16px;
        width: 100%;
        max-width: 360px;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stat dd {
        order: -1;
    }

    .about-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .astro-card {
        position: relative;
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
        transition: border-color 300ms var(--ease-space), transform 500ms var(--ease-space), opacity 700ms var(--ease-space);
    }

    .astro-card:hover {
        border-color: var(--line-strong);
        transform: translateY(-4px);
    }

    .astro-card:has(.stretched:focus-visible) {
        outline: 2px solid var(--accent-text);
        outline-offset: 2px;
    }

    .astro-card :global(.astro-shot) {
        border-radius: 16px;
        border: 1px solid var(--line);
    }

    .astro-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
    }

    .work-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: var(--accent-text);
    }

    .work-meta span:first-child {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .links a {
        position: relative;
        z-index: 1;
    }

    :global(:root[data-motion="reduce"]) .astro-card:hover {
        transform: none;
    }
</style>
