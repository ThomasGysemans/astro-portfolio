---
import { Icon } from "astro-icon/components";
import trans, { comparison, type Availability } from "@i18n";

const lang = Astro.locals.lang;
const t = trans.home;
// Each status has its own icon and colour, and a text for screen readers
const STATUS: Record<Availability, { icon: string, label: string }> = {
    yes: { icon: "check-fill", label: t.yes[lang] },
    opt: { icon: "plus-circle", label: t.opt[lang] },
    var: { icon: "circle-half", label: t.var[lang] },
    no: { icon: "x-circle", label: t.no[lang] },
};
const order: Availability[] = ["yes", "opt", "var", "no"];
---

<section class="section" id="comparatif" aria-labelledby="compare-title">
    <div class="wrap stack">
        <div class="split-head reveal">
            <div>
                <p class="eyebrow caption-3">{t.compareeyebrow[lang]}</p>
                <h2 id="compare-title" class="heading-2 grad">{t.comparetitle[lang]}</h2>
            </div>
            <p class="body-7 text-muted">{t.compareintro[lang]}</p>
        </div>

        <div class="card compare-card reveal">
            <!-- Scrolls sideways on phones; focusable so the keyboard can scroll it too -->
            <div class="table-wrap" role="region" aria-labelledby="compare-title" tabindex="0">
                <table class="compare body-6">
                    <caption class="sr-only">{t.comparecaption[lang]}</caption>
                    <thead>
                        <tr>
                            <th scope="col"><span class="sr-only">{t.criterion[lang]}</span></th>
                            <th scope="col" class="me title-3">{t.withme[lang]}</th>
                            <th scope="col" class="title-3">{t.agency[lang]}</th>
                            <th scope="col" class="title-3">{t.builder[lang]}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {comparison.map(group => (
                            <>
                                <tr class="group"><th scope="colgroup" colspan="4" class="caption-3">{group.group[lang]}</th></tr>
                                {group.rows.map(row => (
                                    <tr>
                                        <th scope="row">{row.label[lang]}</th>
                                        {row.cells.map((cell, i) => (
                                            <td class:list={{ me: i === 0 }}>
                                                <span class:list={["st", cell]}><Icon name={STATUS[cell].icon} class="size-5" /><span class="sr-only">{STATUS[cell].label}</span></span>
                                            </td>
                                        ))}
                                    </tr>
                                ))}
                            </>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="split-head legend-row reveal">
            <ul class="legend caption-2">
                {order.map(status => (
                    <li><span class:list={["st", status]}><Icon name={STATUS[status].icon} class="size-4" /></span>{STATUS[status].label}</li>
                ))}
            </ul>
            <p class="caption-2 text-muted">{t.comparenote[lang]}</p>
        </div>
    </div>
</section>

<style>
    .compare-card {
        overflow: hidden;
    }

    /* relative: the visually hidden labels of the cells (absolute) stay inside
       the scroll box instead of widening the page */
    .table-wrap {
        position: relative;
        overflow-x: auto;
    }

    .compare {
        width: 100%;
        min-width: 680px;
        border-collapse: separate;
        border-spacing: 0;
    }

    .compare th,
    .compare td {
        padding: 16px 24px;
        text-align: center;
        vertical-align: middle;
    }

    .compare thead th {
        color: var(--heading);
        padding-block: 24px;
    }

    .compare tbody th[scope="row"] {
        text-align: left;
        color: var(--heading);
        font-weight: 500;
    }

    .compare tbody tr:not(.group) > * {
        box-shadow: inset 0 1px 0 var(--line);
    }

    .compare .group th {
        text-align: left;
        padding-top: 32px;
        padding-bottom: 8px;
        color: var(--muted);
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .compare .me {
        background: var(--accent-soft);
    }

    .compare thead .me {
        color: var(--accent-text);
    }

    .st {
        display: inline-grid;
        place-items: center;
    }

    .st.yes { color: var(--accent-text); }
    .st.opt { color: var(--color-warn); }
    .st.var { color: var(--muted); }
    .st.no { color: rgb(127 141 173 / 0.75); }

    .legend-row {
        align-items: start;
    }

    .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 24px;
        color: var(--text);
    }

    .legend li {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
</style>
