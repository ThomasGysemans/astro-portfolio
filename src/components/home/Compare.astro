---
import { Icon } from "astro-icon/components";
import trans, { comparison, type Availability } from "@i18n";

const lang = Astro.locals.lang;
const t = trans.home;
// Each status has its own icon and colour, and a text for screen readers
const STATUS: Record<Availability, { icon: string, label: string }> = {
    yes: { icon: "check-fill", label: t.yes[lang] },
    opt: { icon: "plus-circle", label: t.opt[lang] },
    var: { icon: "circle-half", label: t.var[lang] },
    no: { icon: "x-circle", label: t.no[lang] },
};
const order: Availability[] = ["yes", "opt", "var", "no"];
// The three columns. Phones show shorter names, and pair the agency and the
// builder under one name ("Agency / Site builder"), their two answers side by
// side; screen readers always get each column's full name.
const columns = [
    { long: t.withme[lang], short: [t.withme[lang]] },
    { long: t.agency[lang], short: [`${t.agencyshort[lang]} /`, t.buildershort[lang]] },
    { long: t.builder[lang], short: [] },
];
// Classes of the paired columns, on their head and on their cells
const PAIR = ["", "pair-a", "pair-b"];
---

<section class="section" id="comparatif" aria-labelledby="compare-title">
    <div class="wrap stack">
        <div class="split-head reveal">
            <div>
                <p class="eyebrow caption-3">{t.compareeyebrow[lang]}</p>
                <h2 id="compare-title" class="heading-2">{t.comparetitle[lang]}</h2>
            </div>
            <p class="body-7 text-muted">{t.compareintro[lang]}</p>
        </div>

        <div class="card compare-card reveal">
            <table class="compare body-6">
                <caption class="sr-only">{t.comparecaption[lang]}</caption>
                <thead>
                    <tr>
                        <th scope="col"><span class="sr-only">{t.criterion[lang]}</span></th>
                        {columns.map((column, i) => (
                            <th scope="col" class:list={[PAIR[i], { me: i === 0 }]}>
                                <span class="col-long title-3">{column.long}</span>
                                {column.short.length > 0 && (
                                    <span class="col-short caption-1" aria-hidden="true">{column.short.map(part => <span>{part}</span>)}</span>
                                )}
                            </th>
                        ))}
                    </tr>
                </thead>
                {comparison.map(group => (
                    <tbody>
                        <tr class="group"><th scope="rowgroup" colspan="4" class="caption-3"><span>{group.group[lang]}</span></th></tr>
                        {group.rows.map(row => (
                            <tr>
                                <th scope="row">{row.label[lang]}</th>
                                {row.cells.map((cell, i) => (
                                    <td class:list={[PAIR[i], { me: i === 0 }]}>
                                        <span class:list={["st", cell]}><Icon name={STATUS[cell].icon} class="size-5" /><span class="sr-only">{STATUS[cell].label}</span></span>
                                    </td>
                                ))}
                            </tr>
                        ))}
                    </tbody>
                ))}
            </table>
        </div>

        <div class="split-head legend-row reveal">
            <ul class="legend caption-2">
                {order.map(status => (
                    <li><span class:list={["st", status]}><Icon name={STATUS[status].icon} class="size-4" /></span>{STATUS[status].label}</li>
                ))}
            </ul>
            <p class="caption-2 text-muted">{t.comparenote[lang]}</p>
        </div>
    </div>
</section>

<style>
    .compare-card {
        overflow: hidden;
    }

    .compare {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .compare th,
    .compare td {
        padding: 16px 24px;
        text-align: center;
        vertical-align: middle;
    }

    .compare thead th {
        color: var(--heading);
        padding-block: 24px;
    }

    .compare tbody th[scope="row"] {
        text-align: left;
        color: var(--heading);
        font-weight: 500;
    }

    .compare tbody tr:not(.group) > * {
        box-shadow: inset 0 1px 0 var(--line);
    }

    .compare .group th {
        text-align: left;
        padding-top: 32px;
        padding-bottom: 8px;
        color: var(--muted);
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .compare .me {
        background: var(--accent-soft);
    }

    .compare thead .me {
        color: var(--accent-text);
    }

    .st {
        display: inline-grid;
        place-items: center;
    }

    .st.yes { color: var(--accent-text); }
    .st.opt { color: var(--color-warn); }
    .st.var { color: var(--muted); }
    .st.no { color: rgb(127 141 173 / 0.75); }

    .col-short {
        display: none;
    }

    /* Phones: the same table, made compact. The criteria take more than half
       the width; "with me" keeps its column, a continuous band from its name to
       the last row; the agency and the builder share one name, their two answers
       pressed together on either side of the line between their columns. */
    @media (max-width: 767.98px) {
        .compare {
            table-layout: fixed;
            background: linear-gradient(to right, transparent 54%, var(--accent-soft) 54% 72%, transparent 72%);
        }

        .compare thead th.me {
            width: 18%;
        }

        .compare thead .pair-a,
        .compare thead .pair-b {
            width: 14%;
        }

        .compare .me {
            background: none;
        }

        .col-long {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }

        .col-short {
            display: block;
            text-wrap: balance;
        }

        /* The shared name starts a line per part: "Agency /" over "Site
           builder" (which itself wraps on the narrowest phones) */
        .pair-a .col-short span {
            display: block;
        }

        .compare thead th {
            padding: 20px 2px 14px;
        }

        /* The shared name sits over both columns */
        .compare thead .pair-a,
        .compare thead .pair-b {
            padding-inline: 0;
        }

        .compare thead .pair-a .col-short {
            width: 200%;
        }

        .compare tbody td.pair-a {
            text-align: right;
            padding-right: 6px;
        }

        .compare tbody td.pair-b {
            text-align: left;
            padding-left: 6px;
        }

        .compare tbody th[scope="row"] {
            padding: 12px 8px 12px 16px;
        }

        .compare tbody td {
            padding: 12px 0;
        }

        .compare .group th {
            padding: 24px 16px 8px;
        }

        /* A group name stays within the criteria column, off the band */
        .compare .group th span {
            display: block;
            max-width: calc(54% - 24px);
        }
    }

    .legend-row {
        align-items: start;
    }

    .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 24px;
        color: var(--text);
    }

    .legend li {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
</style>
