---
import type { Project, Review } from "@data/models";
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import WorkCard from "./WorkCard.astro";
import trans from "@i18n";

interface Props {
    feature?: Project; // the wide card
    others: Project[]; // the two cards below it
    reviews: { review: Review, project?: Project }[]; // project: the public project the review is about
    total: number; // number of public projects
}

const { feature, others, reviews, total } = Astro.props;
const lang = Astro.locals.lang;
const t = trans.home;
---

<section class="section" id="realisations" aria-labelledby="work-title">
    <div class="wrap stack">
        <div class="split-head reveal">
            <div>
                <p class="eyebrow caption-3">{t.workeyebrow[lang]}</p>
                <h2 id="work-title" class="heading-2">{t.worktitle[lang]}</h2>
            </div>
            <div>
                <p class="body-7 text-muted">{t.workintro[lang]}</p>
                <a class="text-link button-md" href={getRelativeLocaleUrl(lang, "/projects")}>{t.seeallprojects[lang].replace("{count}", `${total}`)} <Icon name="arrow-right" class="size-5" /></a>
            </div>
        </div>

        <div class="works">
            {feature && <WorkCard project={feature} feature />}
            {others.map((project, i) => <WorkCard {project} delay={i * 80} />)}
        </div>

        <!-- Each review is Thomas's summary of what the client said, so it is
             neither quoted nor marked up as a <blockquote>: the note says so -->
        {reviews.length > 0 && (
            <div class="reviews reveal">
                <div class="reviews-head">
                    <h3 class="eyebrow caption-3">{t.reviewseyebrow[lang]}</h3>
                    <p class="caption-2 text-muted">{t.reviewsnote[lang]}</p>
                </div>
                <ul class="reviews-row" role="list">
                    {reviews.map(({ review, project }) => (
                        <li class="review">
                            <div class="stars" role="img" aria-label={t.rating[lang].replace("{n}", `${review.rating}`)}>
                                {Array.from({ length: review.rating }, () => <Icon name="star" class="size-4" />)}
                            </div>
                            <p class="title-2 summary">{review.quote[lang]}</p>
                            <div class="review-foot">
                                <p class="caption-2 text-muted">
                                    {review.role[lang]}, {review.company[lang]}
                                    {lang === "en" && review.translated && <span class="block caption-5">Translated from French</span>}
                                </p>
                                {project && (
                                    <a class="text-link caption-1" href={getRelativeLocaleUrl(lang, `/projects/${project.slug}`)}>
                                        {t.reviewproject[lang].replace("{name}", project.name[lang])} <Icon name="arrow-right" class="size-4" />
                                    </a>
                                )}
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </div>
</section>

<style>
    .works {
        display: grid;
        gap: 24px;
        grid-template-columns: minmax(0, 1fr);
    }

    @media (min-width: 1024px) {
        .works { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    .reviews {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .reviews-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 4px 16px;
    }

    .reviews-row {
        display: grid;
        gap: 16px;
        grid-template-columns: minmax(0, 1fr);
    }

    @media (min-width: 768px) {
        .reviews-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    .review {
        padding: 16px;
        border-radius: 12px;
        /* Nearly opaque, like the cards: a planet drifting behind never
           costs the review its contrast */
        background: var(--panel);
        border: 1px solid var(--line);
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .summary {
        color: var(--heading);
    }

    /* The attribution sits at the bottom of every card, whatever the length
       of the summary above it */
    .review-foot {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }

    .stars {
        display: inline-flex;
        gap: 2px;
        color: var(--color-star);
    }
</style>
