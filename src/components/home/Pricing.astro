---
import { Icon } from "astro-icon/components";
import trans, { plans } from "@i18n";

// Starting price of a showcase website, in euros: a single number rather than
// a string translated twice. Formatting follows the locale ("500 €", "€500").
const STARTING_PRICE = 500;

const lang = Astro.locals.lang;
const t = trans.home;
const price = new Intl.NumberFormat(lang === "fr" ? "fr-FR" : "en-GB", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
}).format(STARTING_PRICE);
---

<section class="section" id="tarifs" aria-labelledby="price-title">
    <div class="wrap stack">
        <div class="split-head reveal">
            <div>
                <p class="eyebrow caption-3">{t.pricingeyebrow[lang]}</p>
                <h2 id="price-title" class="heading-2">{t.pricingtitle[lang]}</h2>
            </div>
            <p class="body-7 text-muted">{t.pricingintro[lang]}</p>
        </div>

        <div class="plans reveal">
            {plans.map(plan => (
                <article class:list={["plan", { hot: plan.startingPrice }]}>
                    <div class="plan-head">
                        <h3 class="plan-title title-1">
                            {plan.title[lang]}
                            {plan.startingPrice && <span class="hot-badge caption-3">{t.fixedprice[lang]}</span>}
                        </h3>
                        <p class="body-6">{plan.pitch[lang]}</p>
                        {plan.startingPrice ? (
                            <p class="price"><span class="caption-2">{t.from[lang]}</span><br /><span class="heading-3 font-mono">{price}</span></p>
                        ) : (
                            <p class="price"><span class="caption-2 text-muted">{t.price[lang]}</span><br /><span class="heading-3">{t.onquote[lang]}</span></p>
                        )}
                        <p class="for caption-2">{plan.audience[lang]}</p>
                    </div>
                    <ul class="checks body-6">
                        {plan.features.map(feature => (
                            <li><Icon name="check-circle" class="size-5" />{feature[lang]}</li>
                        ))}
                    </ul>
                    <a class:list={["btn button-md", plan.startingPrice ? "btn-light" : "btn-ghost"]} href="#devis" data-preset={plan.preset}>{trans.nav.quotelong[lang]}</a>
                </article>
            ))}
        </div>

        <div class="plans-note caption-2 reveal">
            <p>{t.pricingnote1[lang]}</p>
            <p>{t.pricingnote2[lang]}</p>
        </div>
    </div>
</section>

<style>
    .plans {
        display: grid;
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
        border-radius: 24px;
        overflow: hidden;
        grid-template-columns: minmax(0, 1fr);
    }

    @media (min-width: 1024px) {
        .plans { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    .plan {
        background: var(--bg-2);
        padding: 32px 24px;
        display: flex;
        flex-direction: column;
        gap: 24px;
        min-width: 0;
    }

    @media (min-width: 1024px) {
        .plan { padding: 32px; }
    }

    .plan-head {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .plan-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: var(--heading);
    }

    .price {
        color: var(--heading);
        padding-top: 16px;
    }

    .for {
        color: var(--muted);
    }

    .checks {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
    }

    .checks li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        color: var(--heading);
    }

    .checks :global(svg) {
        color: var(--accent-text);
        flex-shrink: 0;
    }

    .plan .btn {
        align-self: stretch;
    }

    /* The highlighted plan: its lightest stop is the accent blue, so white text
       stays at 5.2:1 or more */
    .plan.hot {
        background: linear-gradient(165deg, var(--accent) 0%, var(--accent-hover) 45%, #172F85 100%);
        color: #FFFFFF;
    }

    .plan.hot :is(.plan-title, .price, .checks li, .for, .price span) {
        color: #FFFFFF;
    }

    .plan.hot .checks :global(svg) {
        color: #FFFFFF;
    }

    .hot-badge {
        padding: 2px 8px;
        border-radius: 9999px;
        background: #FFFFFF;
        color: #1D3FAF;
        white-space: nowrap;
    }

    .plans-note {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px 24px;
        color: var(--muted);
    }
</style>
