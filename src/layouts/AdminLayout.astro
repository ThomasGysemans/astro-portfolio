---
// Layout of the back-office: no SEO tags (the pages are private and noindex),
// French only. The shell is the owner's editor workbench: the explorer (every
// project and review, one click away), the page itself, a problems panel and
// a status bar showing the save state. The client side lives in
// src/lib/admin/runtime.ts (async saves, unsaved changes, problems, ⌘S).
import "@styles/tailwind.css";
import "@styles/admin.css";
import AdminIcon from "@components/admin/AdminIcon.astro";
import type { FieldErrors } from "@data/admin/forms";
import { loadExplorer } from "@data/admin/explorer";

interface Props {
    title: string;
    // The login page has no shell; its tab title also stays neutral
    // (no "Admin" suffix revealing what the page is).
    nav?: boolean;
    // Success message, shown by the status bar for a few seconds.
    notice?: string;
    // Server-rendered failure (a native POST, or a delete that failed):
    // opens the problems panel. `fields` lets the runtime mark the controls.
    error?: string;
    fields?: FieldErrors;
}

const { title, nav = true, notice, error, fields } = Astro.props;
const theme = Astro.locals.theme;
const path = Astro.url.pathname.replace(/\/$/, "");
const pb = Astro.locals.admin;

const explorer = nav && pb ? await loadExplorer(pb) : undefined;
const who = pb?.authStore.record?.email as string | undefined;

const isCurrent = (href: string) => path === href;
const inSection = (href: string) => path === href || path.startsWith(href + "/");

const initialState = error ? "error" : notice ? "saved" : "idle";
const initialText = error ? "Enregistrement impossible" : notice ?? "Tout est enregistré";
const filterText = (...parts: (string | number)[]) => parts.join(" ").toLocaleLowerCase("fr");
---

<!DOCTYPE html>
<html lang="fr" data-theme={theme}>
    <head>
        <meta charset="utf-8">
        <link rel="icon" type="image/png" href="/logo.png">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="noindex, nofollow">
        <title>{nav ? `${title} - Admin` : title}</title>
    </head>
    <body class="adm">
        {nav ? (
            <div class="adm-shell">
                <aside id="adm-explorer" class="adm-explorer" aria-label="Explorateur">
                    <div class="adm-explorer-head">
                        <img src="/logo.png" alt="">
                        <span>Back-office</span>
                    </div>
                    <div class="adm-explorer-filter">
                        <AdminIcon name="search" />
                        <kbd class="adm-keycap" aria-hidden="true">/</kbd>
                        <input type="search" placeholder="Filtrer…" aria-label="Filtrer l'explorateur (raccourci : /)" aria-keyshortcuts="/" data-filter="#adm-tree" autocomplete="off">
                    </div>
                    <nav id="adm-tree" class="adm-tree" aria-label="Contenu du site">
                        <section class="adm-tree-section" data-filter-group>
                            <div class="adm-tree-head">
                                <button type="button" class="adm-twisty" data-tree-toggle aria-controls="adm-tree-projects" aria-expanded="true" aria-label="Replier ou déplier les projets"><AdminIcon name="chevronRight" /></button>
                                <a href="/admin/projects" aria-current={isCurrent("/admin/projects") ? "page" : undefined}>
                                    Projets <span class="adm-count">{explorer?.projects.length}</span>
                                </a>
                                <a href="/admin/projects/new" class="adm-tree-add" title="Nouveau projet" aria-label="Nouveau projet"><AdminIcon name="plus" /></a>
                            </div>
                            <ul id="adm-tree-projects">
                                {explorer?.projects.map(project => (
                                    <li data-filter-text={filterText(project.name, project.slug)}>
                                        <a
                                            href={`/admin/projects/${project.id}`}
                                            class:list={["adm-tree-item", { "is-hidden": project.hidden }]}
                                            aria-current={inSection(`/admin/projects/${project.id}`) ? "page" : undefined}
                                            title={project.hidden ? `${project.name} (masqué)` : project.name}
                                        >
                                            <AdminIcon name="file" />
                                            <span class="adm-tree-name">{project.name}</span>
                                            <span class="adm-decos">
                                                {project.carousel && <span class="adm-deco-carousel" title="Projet du carrousel"><AdminIcon name="carousel" /><span class="adm-sr-only">carrousel</span></span>}
                                                {project.featured && <span class="adm-deco-featured" title="Projet vitrine"><AdminIcon name="star" /><span class="adm-sr-only">vitrine</span></span>}
                                                {project.hidden && <span class="adm-deco-hidden" title="Masqué"><AdminIcon name="eyeOff" /><span class="adm-sr-only">masqué</span></span>}
                                            </span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                        <section class="adm-tree-section" data-filter-group>
                            <div class="adm-tree-head" data-filter-text="technologies">
                                <a href="/admin/technologies" aria-current={isCurrent("/admin/technologies") ? "page" : undefined}>
                                    Technologies <span class="adm-count">{explorer?.technologies}</span>
                                </a>
                            </div>
                        </section>
                        <section class="adm-tree-section" data-filter-group>
                            <div class="adm-tree-head">
                                <button type="button" class="adm-twisty" data-tree-toggle aria-controls="adm-tree-reviews" aria-expanded="true" aria-label="Replier ou déplier les avis"><AdminIcon name="chevronRight" /></button>
                                <a href="/admin/reviews" aria-current={isCurrent("/admin/reviews") ? "page" : undefined}>
                                    Avis clients <span class="adm-count">{explorer?.reviews.length}</span>
                                </a>
                                <a href="/admin/reviews/new" class="adm-tree-add" title="Nouvel avis" aria-label="Nouvel avis"><AdminIcon name="plus" /></a>
                            </div>
                            <ul id="adm-tree-reviews">
                                {explorer?.reviews.map(review => (
                                    <li data-filter-text={filterText(review.company, review.year)}>
                                        <a
                                            href={`/admin/reviews/${review.id}`}
                                            class="adm-tree-item"
                                            aria-current={inSection(`/admin/reviews/${review.id}`) ? "page" : undefined}
                                        >
                                            <AdminIcon name="quote" />
                                            <span class="adm-tree-name">{review.company}</span>
                                            <span class="adm-mono">{review.year}</span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                        <p class="adm-tree-empty" data-filter-empty hidden>Aucun résultat.</p>
                    </nav>
                    <div class="adm-explorer-foot">
                        {who && <span class="adm-who" title={who}>{who}</span>}
                        <a href="/" target="_blank" rel="noopener"><AdminIcon name="external" />Voir le site</a>
                        <form method="POST" action="/admin/logout">
                            <button type="submit"><AdminIcon name="logout" />Déconnexion</button>
                        </form>
                    </div>
                </aside>
                <div class="adm-explorer-backdrop" data-explorer-backdrop></div>

                <main id="adm-main" class="adm-main">
                    <slot />
                </main>

                <section id="adm-problems" class="adm-problems" aria-labelledby="adm-problems-title" hidden={!error}>
                    <header>
                        <h2 id="adm-problems-title" tabindex="-1" data-problems-title>Problèmes</h2>
                        <button type="button" class="adm-btn-ghost adm-btn-sm adm-btn-icon" data-problems-close aria-label="Masquer les problèmes"><AdminIcon name="x" /></button>
                    </header>
                    <!-- Without JS, the full message (context and every field detail
                         included); the runtime replaces it with one row per field,
                         labelled and linked to its control. -->
                    <ul data-problems-list>
                        {error && (
                            <li><span class="adm-problem"><span class="adm-problem-icon" aria-hidden="true">✕</span><span class="adm-problem-message">{error}</span></span></li>
                        )}
                    </ul>
                </section>
                {error && <script is:inline type="application/json" id="adm-initial-problems" set:html={JSON.stringify({ error, fields }).replace(/</g, "\\u003c")} />}

                <footer id="adm-status" class="adm-status" data-state={initialState}>
                    <button type="button" class="adm-status-item adm-explorer-toggle" data-explorer-toggle aria-controls="adm-explorer" aria-expanded="false">
                        <AdminIcon name="menu" /><span class="adm-sr-only">Explorateur</span>
                    </button>
                    <span class="adm-status-item adm-status-text" data-status-text>{initialText}</span>
                    <button type="button" class="adm-status-item" data-status-problems hidden={!error} aria-controls="adm-problems">
                        <AdminIcon name="alert" /><span data-count>1</span><span class="adm-sr-only">problèmes : afficher ou masquer le panneau</span>
                    </button>
                    <span class="adm-status-spacer" />
                    <span class="adm-status-item adm-status-hide-sm" data-save-hint><span class="adm-mono">⌘S / Ctrl+S</span>&nbsp;enregistrer</span>
                    <a href="/" target="_blank" rel="noopener" class="adm-status-item adm-status-hide-sm"><AdminIcon name="external" />thomasgysemans.dev</a>
                    <button type="button" class="adm-status-item" data-theme-toggle title="Changer de thème" aria-label="Changer de thème">
                        <AdminIcon name="sun" class="icon-sun" /><AdminIcon name="moon" class="icon-moon" />
                    </button>
                </footer>
            </div>
        ) : (
            <>
                <div class="adm-login">
                    <div class="adm-login-side" aria-hidden="true"></div>
                    <main class="adm-login-main">
                        <slot />
                    </main>
                </div>
                <footer class="adm-status adm-login-status" data-state={error ? "error" : "idle"}>
                    <span class="adm-status-item adm-status-text">{error ? "Connexion refusée" : "Non connecté"}</span>
                </footer>
            </>
        )}

        <div id="adm-live" class="adm-sr-only" aria-live="assertive"></div>

        <dialog id="adm-confirm" class="adm-modal" aria-labelledby="adm-confirm-title" aria-describedby="adm-confirm-message">
            <h2 id="adm-confirm-title"><AdminIcon name="trash" />Suppression définitive</h2>
            <p id="adm-confirm-message"></p>
            <div class="flex justify-end gap-2 mt-5">
                <button type="button" id="adm-confirm-cancel" class="adm-btn-outline">Annuler</button>
                <button type="button" id="adm-confirm-ok" class="adm-btn-danger">Supprimer</button>
            </div>
        </dialog>

        <script>
            import "@lib/admin/runtime";
        </script>
    </body>
</html>
