---
import "@styles/tailwind.css";
import { alternateLinks, pathInLocale } from "@i18n";

interface Props {
    title: string;
    description?: string;
    image?: string; // absolute or root-relative URL of the social-share image
    imageAlt?: string; // description of `image` (required by it, ignored without it)
    noindex?: boolean; // keep the page out of search engines (404, etc.)
    bodyClass?: string;
}

const DOMAIN = "https://thomasgysemans.dev";
const AUTHOR = "Thomas Gysemans";
const DEFAULT_IMAGE = `${DOMAIN}/logo.png`;
// Social-share card used when a page passes no `image` of its own, one per
// locale since the card carries text. Its intrinsic size is advertised so
// scrapers can lay the card out before fetching the file. 1200x630 is the
// recommended Open Graph size (scrapers download it on every share); PNG on
// purpose, the text stays crisper than JPEG.
const DEFAULT_SOCIAL_IMAGE = {
    "fr": `${DOMAIN}/og-fr.png`,
    "en": `${DOMAIN}/og-en.png`,
} satisfies Record<App.LangCode, string>;
const DEFAULT_SOCIAL_IMAGE_SIZE = { width: 1200, height: 630 };
// Transcribes the text of the card, which is all of its content.
const DEFAULT_SOCIAL_IMAGE_ALT = {
    "fr": "Thomas Gysemans, développeur et designer freelance : des sites et des applis qui mettent votre projet en orbite. Web, iOS & Android ; accessible (RGAA) ; conforme au RGPD. thomasgysemans.dev",
    "en": "Thomas Gysemans, freelance developer and designer: websites and apps that put your project into orbit. Web, iOS & Android; accessible (RGAA & WCAG); GDPR-compliant. thomasgysemans.dev",
} satisfies Record<App.LangCode, string>;

const { title, description, image, imageAlt, noindex = false, bodyClass } = Astro.props;
const lang = Astro.locals.lang;
const og = {
    locale: {
        "fr": "fr_FR",
        "en": "en_US",
    },
    site_name: {
        "fr": "Portfolio de Thomas Gysemans",
        "en": "Portfolio of Thomas Gysemans",
    },
    description: {
        "fr": "Développeur et designer freelance : sites, applications mobiles et logiciels conçus de A à Z, rapides, accessibles (RGAA) et conformes au RGPD.",
        "en": "Freelance developer and designer: websites, mobile apps and software built from A to Z, fast, accessible and GDPR-compliant.",
    },
} satisfies Record<string, Record<App.LangCode, string>>;

const metaDescription = description ?? og.description[lang];

// Each language version is self-canonical so both stay indexable. Under the
// i18n fallback `rewrite`, `Astro.url.pathname` has already lost the `/en`
// prefix, so the canonical URL is rebuilt from the served locale. `pathInLocale`
// also drops the trailing slash, giving one canonical form per page.
const canonical = `${DOMAIN}${pathInLocale(lang, Astro.url.pathname)}`;

// Social-share image: absolute URLs (e.g. PocketBase thumbnails) are used as-is,
// root-relative ones are resolved against the domain. Only the default card has
// known dimensions — a custom `image` (a project thumbnail cropped to 1200px
// wide) has a height we can't assert here, so its size meta is omitted.
const rawImage = image ?? DEFAULT_SOCIAL_IMAGE[lang];
const socialImage = /^https?:\/\//.test(rawImage) ? rawImage : `${DOMAIN}${rawImage}`;
const usingDefaultImage = image === undefined;
// A custom image without a description falls back to the page title rather
// than the default card's text, which would describe another picture.
const socialImageAlt = usingDefaultImage ? DEFAULT_SOCIAL_IMAGE_ALT[lang] : (imageAlt || title);

const alternates = alternateLinks(Astro.url.pathname, DOMAIN);

// Structured data helps search engines identify the person behind the site.
const structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: AUTHOR,
    url: DOMAIN,
    image: DEFAULT_IMAGE,
    jobTitle: lang === "fr" ? "Développeur et designer freelance" : "Freelance developer and designer",
    description: og.description[lang],
    sameAs: [
        "https://github.com/ThomasGysemans",
        "https://www.linkedin.com/in/thomas-gysemans-950536268",
        "https://malt.fr/profile/thomasgysemans",
    ],
};
---

<!DOCTYPE html>
<html {lang} data-motion="full">
    <head>
        <meta charset="utf-8">
        <!-- Before anything paints: animations are off when the visitor paused
             them (remembered by the pause button) or when the system asks for
             reduced motion. Every animated part of the site reads this. -->
        <script is:inline>
            (function () {
                var stored = null;
                try { stored = localStorage.getItem("motion"); } catch (e) {}
                var reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
                document.documentElement.dataset.motion = stored === "reduce" || stored === "full" ? stored : (reduce ? "reduce" : "full");
            })();
        </script>
        <link rel="icon" type="image/png" href="/logo.png">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
        <meta name="theme-color" content="#030713">
        <!-- The page is dark by design. "color-scheme" lets the browser paint a
             dark canvas before the CSS arrives; "darkreader-lock" keeps the Dark
             Reader extension off, which would otherwise recolour the text a
             yellowish grey and darken the heading gradients into grey -->
        <meta name="color-scheme" content="dark">
        <meta name="darkreader-lock">
        <meta name="generator" content={Astro.generator}>
        <!-- A @font-face is only fetched once the CSS is parsed and a node using
             it is laid out; preloading starts the download with the HTML, which
             keeps the swap from being visible. Geist Mono is left out: it only
             sets small labels, where a late swap is barely visible. -->
        <link rel="preload" href="/fonts/geist-vf.woff2" as="font" type="font/woff2" crossorigin>
        <title>{title}</title>

        <link rel="canonical" href={canonical}>
        {noindex && <meta name="robots" content="noindex, nofollow">}

        <meta property="og:title" content={title}>
        <meta property="og:type" content="website">
        <meta property="og:url" content={canonical}>
        <meta property="og:locale" content={og.locale[lang]}>
        <meta property="og:site_name" content={og.site_name[lang]}>
        <meta property="og:description" content={metaDescription}>
        <meta property="og:image" content={socialImage}>
        <meta property="og:image:alt" content={socialImageAlt}>
        {usingDefaultImage && (
            <>
                <meta property="og:image:width" content={String(DEFAULT_SOCIAL_IMAGE_SIZE.width)}>
                <meta property="og:image:height" content={String(DEFAULT_SOCIAL_IMAGE_SIZE.height)}>
                <meta property="og:image:type" content="image/png">
            </>
        )}
        <meta name="description" content={metaDescription}>
        <!-- Read by link-preview scrapers (LinkedIn's Post Inspector reports
             "No author found" without it). -->
        <meta name="author" content={AUTHOR}>
        <meta name="keywords" content="portfolio, Thomas Gysemans, développeur, développeur web, développeur d'applications, freelance, web developer, mobile developer, developer, webmaster, back-end, backend, frontend, front-end, designer">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content={metaDescription}>
        <meta name="twitter:image" content={socialImage}>
        <meta name="twitter:image:alt" content={socialImageAlt}>

        <meta http-equiv="content-language" content={lang} />

        {alternates.map(alt => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))}

        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
        <slot name="head" />
    </head>
    <body class:list={["overflow-x-hidden", bodyClass]}>
        <slot />
    </body>
</html>
