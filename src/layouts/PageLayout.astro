---
import "@styles/tailwind.scss";
import { alternateLinks } from "@i18n";

interface Props {
    title: string;
    description?: string;
}

const DOMAIN = "https://thomasgysemans.dev";

const { title, description } = Astro.props;
const lang = Astro.locals.lang;
const theme = Astro.locals.theme;
const og = {
    title: {
        "fr": "Portfolio de Thomas Gysemans - webmaster et développeur d'applications",
        "en": "Portfolio of Thomas Gysemans - webmaster and app developer",
    },
    locale: {
        "fr": "fr_FR",
        "en": "en_US",
    },
    site_name: {
        "fr": "Portfolio de Thomas Gysemans",
        "en": "Portfolio of Thomas Gysemans",
    },
    description: {
        "fr": "Je suis développeur d'applications et de sites internet, disponible en freelance, et je présente ici mes compétences et mes anciens projets.",
        "en": "I am an application and website developer, available for freelance work, and I present here my skills and my past projects.",
    },
} satisfies Record<string, Record<App.LangCode, string>>;

const metaDescription = description ?? og.description[lang];
const alternates = alternateLinks(Astro.url.pathname, DOMAIN);
---

<!DOCTYPE html>
<html {lang} data-theme={theme}>
    <head>
        <meta charset="utf-8">
        <link rel="icon" type="image/png" href="/logo.png">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="generator" content={Astro.generator}>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&display=swap">
        <title>{title}</title>

        <meta property="og:title" content={og.title[lang]}>
        <meta property="og:type" content="website">
        <meta property="og:url" content={DOMAIN}>
        <meta property="og:locale" content={og.locale[lang]}>
        <meta property="og:site_name" content={og.site_name[lang]}>
        <meta property="og:description" content={metaDescription}>
        <meta name="description" content={metaDescription}>
        <meta name="keywords" content="portfolio, Thomas Gysemans, développeur, développeur web, développeur d'applications, freelance, web developer, mobile developer, developer, webmaster, back-end, backend, frontend, front-end, designer">

        <meta http-equiv="content-language" content={lang} />

        {alternates.map(alt => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))}
    </head>
    <body class="overflow-x-hidden">
        <slot />
    </body>
</html>
