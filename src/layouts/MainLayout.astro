---
import PageLayout from "./PageLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SpaceBackdrop from "@components/SpaceBackdrop.astro";
import MotionToggle from "@components/MotionToggle.astro";
import type { PlanetPlacement } from "@lib/space/planets";
import trans from "@i18n";

interface Props {
    title: string;
    description?: string;
    image?: string; // social-share image (defaults to the locale's OG card)
    imageAlt?: string; // description of `image`
    noindex?: boolean; // keep the page out of search engines
    planets?: PlanetPlacement[]; // the bodies drifting behind this page
}

const { title, description, image, imageAlt, noindex, planets } = Astro.props;
const lang = Astro.locals.lang;
---

<PageLayout {title} {description} {image} {imageAlt} {noindex}>
    <slot name="head" slot="head" />
    <SpaceBackdrop {planets} />
    <a href="#main-content" class="skip-link button-sm">{trans.common.skiptocontent[lang]}</a>
    <Header />
    <slot />
    <Footer />
    <MotionToggle />
</PageLayout>

<script>
    import { mountReveals } from "@lib/reveal";

    mountReveals();
</script>
