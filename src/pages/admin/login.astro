---
import AdminLoginPage from "@components/pages/admin/AdminLoginPage.astro";
import { adminLogin, setAdminCookie } from "@data/admin/client";

// The middleware already redirects logged-in superusers to /admin/projects.
let error: string | undefined;
let email: string | undefined;

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();
    email = String(data.get("email") ?? "");
    const password = String(data.get("password") ?? "");

    try {
        const token = await adminLogin(email, password);
        setAdminCookie(Astro.cookies, token);
        return Astro.redirect("/admin/projects");
    } catch (failure) {
        // Same message for every refused login: no hint about which field is
        // wrong. A server that does not answer at all is another matter.
        const status = (failure as { status?: unknown }).status;
        error = status === 0 || (typeof status === "number" && status >= 500)
            ? "PocketBase est injoignable. Vérifiez qu'il tourne, puis réessayez."
            : "Identifiants invalides.";
    }
}
---

<AdminLoginPage {error} {email} />
