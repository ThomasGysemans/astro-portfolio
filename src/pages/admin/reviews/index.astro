---
import AdminReviewsPage from "@components/pages/admin/AdminReviewsPage.astro";
import { type FormResult, failure, formResponse, isAsyncRequest } from "@data/admin/forms";
import { invalidateCache } from "@data/pb";
import { listAdminReviews } from "@data/admin/reviews";

const pb = Astro.locals.admin!;
let error: string | undefined;

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();
    let result: FormResult = { error: "Action invalide." };
    if (data.get("action") === "delete") {
        try {
            await pb.collection("reviews").delete(String(data.get("id")));
            invalidateCache();
            result = { redirect: "/admin/reviews?deleted=1" };
        } catch (err) {
            result = failure(err);
        }
    }
    if (isAsyncRequest(Astro.request)) return formResponse(result);
    if ("redirect" in result) return Astro.redirect(result.redirect);
    error = result.error;
}

const reviews = await listAdminReviews(pb);

const notice = Astro.url.searchParams.has("deleted") ? "Avis supprimé."
    : Astro.url.searchParams.has("saved") ? "Avis enregistré." : undefined;
---

<AdminReviewsPage {reviews} {notice} {error} />
