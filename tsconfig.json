{
    "extends": "astro/tsconfigs/strict",
    // The PocketBase migrations reference a types.d.ts that only exists
    // inside the container's data directory.
    "exclude": ["dist", "db/pb_migrations"],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@*": ["src/*"],
            "@components/*": ["src/components/*"],
            "@layouts/*": ["src/layouts/*"],
            "@styles/*": ["src/styles/*"],
            "@lib/*": ["src/lib/*"],
            "@data/*": ["src/data/*"],
            "@i18n": ["src/i18n/index.ts"],
            "@i18n/*": ["src/i18n/*"],
        }
    }
}