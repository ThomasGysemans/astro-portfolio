{
    "extends": "astro/tsconfigs/strict",
    // The PocketBase migrations reference a types.d.ts that only exists
    // inside the container's data directory. The test-runner config files use
    // their runners' own type augmentations (e.g. Vitest's `test` key on the
    // Vite config), so they are transpiled by those tools, not by astro check.
    "exclude": ["dist", "db/pb_migrations", "vitest.config.ts", "playwright.config.ts"],
    "compilerOptions": {
        // Relative to this file: `baseUrl` is deprecated in TypeScript 6
        "paths": {
            "@*": ["./src/*"],
            "@components/*": ["./src/components/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@styles/*": ["./src/styles/*"],
            "@lib/*": ["./src/lib/*"],
            "@data/*": ["./src/data/*"],
            "@i18n": ["./src/i18n/index.ts"],
            "@i18n/*": ["./src/i18n/*"],
        }
    }
}